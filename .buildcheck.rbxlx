      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MonsterConfig</string>
          <string name="Source"><![CDATA[local RarityConfig = require(script.Parent:WaitForChild("RarityConfig"))
local SizeConfig = require(script.Parent:WaitForChild("SizeConfig"))
local Config = {}

-- Initial base rates. Rarity is the species default; hatched instances inherit egg rarity.
local function definition(name, biome, rarity, income, modelName, indexId, color)
	return { MonsterName = name, Biome = biome, Rarity = rarity, BaseIncome = income,
		ModelName = modelName, IndexId = indexId, Icon = "", Color = color }
end

Config.Definitions = {
	green_slime = definition("Green Slime", "HatchlingFields", "Common", 25, "GreenSlime", "green_slime", Color3.fromRGB(80, 210, 100)),
	leaf_bunny = definition("Leaf Bunny", "HatchlingFields", "Uncommon", 75, "LeafBunny", "leaf_bunny", Color3.fromRGB(170, 225, 100)),
	baby_goblin = definition("Baby Goblin", "HatchlingFields", "Rare", 250, "BabyGoblin", "baby_goblin", Color3.fromRGB(90, 150, 65)),
	forest_dragon = definition("Forest Dragon", "HatchlingFields", "Legendary", 1200, "ForestDragon", "forest_dragon", Color3.fromRGB(35, 125, 75)),
	-- First production monster model. Put the rig at ServerStorage.MonsterModels.Floragon.
	-- Its walk animation is read from an Animation named "WalkAnimation" inside the model,
	-- or from the model's WalkAnimationId attribute.
	floragon = definition("Floragon", "HatchlingFields", "Legendary", 1500, "Floragon", "floragon", Color3.fromRGB(74, 176, 91)),
	magma_slime = definition("Magma Slime", "Volcano", "Rare", 20000000, "MagmaSlime", "magma_slime", Color3.fromRGB(255, 115, 35)),
	flame_goblin = definition("Flame Goblin", "Volcano", "Epic", 80000000, "FlameGoblin", "flame_goblin", Color3.fromRGB(210, 65, 40)),
	inferno_dragon = definition("Inferno Dragon", "Volcano", "Legendary", 400000000, "InfernoDragon", "inferno_dragon", Color3.fromRGB(150, 35, 35)),
}

function Config.CalculateIncome(monsterId, rarity, size)
	local entry = Config.Definitions[monsterId]
	local rarityMultiplier = RarityConfig.GetIncomeMultiplier(rarity)
	local sizeMultiplier = SizeConfig.GetIncomeMultiplier(size)
	if not entry or not rarityMultiplier or not sizeMultiplier then return nil end
	local base = entry.BaseIncome
	if type(base) ~= "number" or base ~= base or base < 0 or base == math.huge then return nil end
	return base * rarityMultiplier * sizeMultiplier
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">MonsterWanderConfig</string>
          <string name="Source"><![CDATA[return {
	MinWalkDistance = 2.5,
	MaxWalkDistance = 7,
	MinWalkSpeed = 2.2,
	MaxWalkSpeed = 3.5,
	MinPause = 1.5,
	MaxPause = 4.5,
	EdgeMargin = 0.5,
	NeighborGap = 0.75,
	DestinationAttempts = 12,
	ScanInterval = 0.5,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">NumberFormatter</string>
          <string name="Source"><![CDATA[--!strict

local Formatter = {}

local suffixes = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg",
}

local function trim(text: string): string
	text = string.gsub(text, "(%..-)0+$", "%1")
	return string.gsub(text, "%.$", "")
end

function Formatter.Format(value: unknown): string
	local number = tonumber(value)
	if not number or number ~= number then return "0" end
	if number == math.huge then return "∞" end
	if number == -math.huge then return "-∞" end
	local absolute = math.abs(number)
	if absolute < 1000 then
		if number == math.floor(number) then return string.format("%.0f", number) end
		return trim(string.format("%.1f", number))
	end

	local group = math.floor(math.log10(absolute) / 3)
	if group >= #suffixes then return string.format("%.2e", number) end
	local scaled = number / (10 ^ (group * 3))
	local formatted
	if math.abs(scaled) >= 100 then
		formatted = string.format("%.0f", scaled)
	elseif math.abs(scaled) >= 10 then
		formatted = string.format("%.1f", scaled)
	else
		formatted = string.format("%.2f", scaled)
	end
	return trim(formatted) .. suffixes[group + 1]
end

return Formatter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
