        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">AreaLighting</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Profiles = require(
	ReplicatedStorage
		:WaitForChild("Modules")
		:WaitForChild("LightingProfiles")
)

local Areas = workspace:WaitForChild("Areas")

local TRANSITION_TIME = 1.5
local CHECK_INTERVAL = 0.15

local currentArea = nil
local elapsed = 0

-- Kreiramo efekte ako već ne postoje

local atmosphere = Lighting:FindFirstChild("AreaAtmosphere")

if not atmosphere then
	atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "AreaAtmosphere"
	atmosphere.Parent = Lighting
end

local colorCorrection = Lighting:FindFirstChild("AreaColorCorrection")

if not colorCorrection then
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "AreaColorCorrection"
	colorCorrection.Parent = Lighting
end

local bloom = Lighting:FindFirstChild("AreaBloom")

if not bloom then
	bloom = Instance.new("BloomEffect")
	bloom.Name = "AreaBloom"
	bloom.Parent = Lighting
end

local tweenInfo = TweenInfo.new(
	TRANSITION_TIME,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.Out
)

-- Preserve the starting lighting before any area profile is applied.
local defaultProperties = {}
local activeTweens = {}

local function rememberDefaults(object, propertyNames)
	local properties = {}
	for _, name in ipairs(propertyNames) do
		properties[name] = object[name]
	end
	defaultProperties[object] = properties
end

rememberDefaults(Lighting, {
	"Brightness", "ClockTime", "ExposureCompensation", "Ambient", "OutdoorAmbient",
})
rememberDefaults(atmosphere, { "Density", "Offset", "Color", "Decay", "Glare", "Haze" })
rememberDefaults(colorCorrection, { "Brightness", "Contrast", "Saturation", "TintColor" })
rememberDefaults(bloom, { "Intensity", "Size", "Threshold" })

local function resetLighting()
	for object, tween in pairs(activeTweens) do
		tween:Cancel()
		activeTweens[object] = nil
	end
	for object, properties in pairs(defaultProperties) do
		for name, value in pairs(properties) do
			object[name] = value
		end
	end
	currentArea = nil
	elapsed = 0
end

local function tweenObject(object, properties)
	if activeTweens[object] then
		activeTweens[object]:Cancel()
	end
	local tween = TweenService:Create(
		object,
		tweenInfo,
		properties
	)

	activeTweens[object] = tween
	tween:Play()

	return tween
end

local function applyProfile(areaName)
	local profile = Profiles[areaName]

	if not profile then
		warn("Nema Lighting profila za area:", areaName)
		return
	end

	print("Lighting area:", areaName)

	-- Glavni Lighting

	local lightingProperties = {}

	if profile.Brightness ~= nil then
		lightingProperties.Brightness = profile.Brightness
	end

	if profile.ClockTime ~= nil then
		lightingProperties.ClockTime = profile.ClockTime
	end

	if profile.ExposureCompensation ~= nil then
		lightingProperties.ExposureCompensation =
			profile.ExposureCompensation
	end

	if profile.Ambient ~= nil then
		lightingProperties.Ambient = profile.Ambient
	end

	if profile.OutdoorAmbient ~= nil then
		lightingProperties.OutdoorAmbient =
			profile.OutdoorAmbient
	end

	tweenObject(
		Lighting,
		lightingProperties
	)

	-- Atmosphere

	if profile.Atmosphere then
		local data = profile.Atmosphere

		tweenObject(atmosphere, {
			Density = data.Density or atmosphere.Density,
			Offset = data.Offset or atmosphere.Offset,
			Color = data.Color or atmosphere.Color,
			Decay = data.Decay or atmosphere.Decay,
			Glare = data.Glare or atmosphere.Glare,
			Haze = data.Haze or atmosphere.Haze,
		})
	end

	-- Color Correction

	if profile.ColorCorrection then
		local data = profile.ColorCorrection

		tweenObject(colorCorrection, {
			Brightness = data.Brightness
				or colorCorrection.Brightness,

			Contrast = data.Contrast
				or colorCorrection.Contrast,

			Saturation = data.Saturation
				or colorCorrection.Saturation,

			TintColor = data.TintColor
				or colorCorrection.TintColor,
		})
	end

	-- Bloom

	if profile.Bloom then
		local data = profile.Bloom

		tweenObject(bloom, {
			Intensity = data.Intensity
				or bloom.Intensity,

			Size = data.Size
				or bloom.Size,

			Threshold = data.Threshold
				or bloom.Threshold,
		})
	end
end

local function isPointInsidePart(point, part)
	local relativePoint =
		part.CFrame:PointToObjectSpace(point)

	local halfSize = part.Size / 2

	return
		math.abs(relativePoint.X) <= halfSize.X
		and math.abs(relativePoint.Y) <= halfSize.Y
		and math.abs(relativePoint.Z) <= halfSize.Z
end

local function getCurrentArea(position)
	for _, area in ipairs(Areas:GetChildren()) do

		local zone =
			area:FindFirstChild("LightingZone")

		if zone
			and zone:IsA("BasePart")
			and isPointInsidePart(position, zone)
		then
			return area.Name
		end
	end

	return nil
end

local function updateArea()
	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local rootPart =
		character:FindFirstChild("HumanoidRootPart")

	if not rootPart then
		return
	end

	local areaName =
		getCurrentArea(rootPart.Position)

	if areaName
		and areaName ~= currentArea
	then

		currentArea = areaName

		applyProfile(areaName)
	end
end

local deathConnection = nil

local function onCharacterAdded(character)
	if deathConnection then
		deathConnection:Disconnect()
		deathConnection = nil
	end
	resetLighting()

	local humanoid = character:WaitForChild("Humanoid")
	if player.Character ~= character then
		return
	end
	deathConnection = humanoid.Died:Connect(resetLighting)
	if humanoid.Health <= 0 then
		resetLighting()
	end
end

player.CharacterAdded:Connect(onCharacterAdded)
player.CharacterRemoving:Connect(function()
	if deathConnection then
		deathConnection:Disconnect()
		deathConnection = nil
	end
	resetLighting()
end)

if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end

RunService.Heartbeat:Connect(function(deltaTime)

	elapsed += deltaTime

	if elapsed < CHECK_INTERVAL then
		return
	end

	elapsed = 0

	updateArea()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">BiomeUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local NumberFormatter = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("NumberFormatter"))

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local event = ReplicatedStorage:WaitForChild("BiomeUIEvent")

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local AUTO_HIDE_TIME = 2.5
local SHOW_TIME = 0.22
local HIDE_TIME = 0.18

--------------------------------------------------
-- GUI
--------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "BiomeUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.IgnoreGuiInset = false
gui.Parent = playerGui

--------------------------------------------------
-- MAIN PANEL
--------------------------------------------------

local panel = Instance.new("Frame")
panel.Name = "Panel"

panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 18)

panel.Size = UDim2.new(0, 230, 0, 72)

panel.BackgroundColor3 = Color3.fromRGB(10, 13, 18)
panel.BackgroundTransparency = 0.28

panel.BorderSizePixel = 0
panel.Visible = false

panel.Parent = gui

--------------------------------------------------
-- CORNER
--------------------------------------------------

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = panel

--------------------------------------------------
-- STROKE
--------------------------------------------------

local stroke = Instance.new("UIStroke")

stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.88
stroke.Thickness = 1

stroke.Parent = panel

--------------------------------------------------
-- GRADIENT
--------------------------------------------------

local gradient = Instance.new("UIGradient")

gradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(
		0,
		Color3.fromRGB(28, 33, 44)
	),

	ColorSequenceKeypoint.new(
		1,
		Color3.fromRGB(11, 14, 20)
	)
})

gradient.Rotation = 90

gradient.Parent = panel

--------------------------------------------------
-- BIOME NAME
--------------------------------------------------

local biomeName = Instance.new("TextLabel")

biomeName.Name = "BiomeName"

biomeName.Position = UDim2.new(0, 14, 0, 10)
biomeName.Size = UDim2.new(1, -28, 0, 25)

biomeName.BackgroundTransparency = 1

biomeName.Font = Enum.Font.GothamBold
biomeName.TextSize = 17

biomeName.TextColor3 = Color3.fromRGB(245, 248, 255)

biomeName.Text = ""

biomeName.TextXAlignment = Enum.TextXAlignment.Center

biomeName.Parent = panel

--------------------------------------------------
-- RECOMMENDED SPEED
--------------------------------------------------

local recommended = Instance.new("TextLabel")

recommended.Name = "Recommended"

recommended.Position = UDim2.new(0, 14, 0, 37)
recommended.Size = UDim2.new(1, -28, 0, 22)

recommended.BackgroundTransparency = 1

recommended.Font = Enum.Font.GothamMedium
recommended.TextSize = 13

recommended.TextColor3 = Color3.fromRGB(170, 180, 198)

recommended.Text = "Recommended Speed  •  0"

recommended.TextXAlignment = Enum.TextXAlignment.Center

recommended.Parent = panel

--------------------------------------------------
-- FORMAT SPEED
--------------------------------------------------

local function formatSpeed(value)
	return NumberFormatter.Format(value)
end

--------------------------------------------------
-- STATE
--------------------------------------------------

local hideTask = nil
local showing = false

--------------------------------------------------
-- SHOW PANEL
--------------------------------------------------

local function showPanel()

	showing = true

	panel.Position = UDim2.new(0.5, 0, 0, 5)

	panel.BackgroundTransparency = 1

	biomeName.TextTransparency = 1
	recommended.TextTransparency = 1

	panel.Visible = true

	--------------------------------------------------
	-- PANEL ANIMATION
	--------------------------------------------------

	TweenService:Create(
		panel,

		TweenInfo.new(
			SHOW_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			Position = UDim2.new(0.5, 0, 0, 18),
			BackgroundTransparency = 0.28
		}

	):Play()

	--------------------------------------------------
	-- TEXT ANIMATION
	--------------------------------------------------

	TweenService:Create(
		biomeName,

		TweenInfo.new(
			SHOW_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			TextTransparency = 0
		}

	):Play()

	TweenService:Create(
		recommended,

		TweenInfo.new(
			SHOW_TIME + 0.03,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			TextTransparency = 0
		}

	):Play()

end

--------------------------------------------------
-- HIDE PANEL
--------------------------------------------------

local function hidePanel()

	if not panel.Visible then
		return
	end

	showing = false

	--------------------------------------------------
	-- TEXT FADE
	--------------------------------------------------

	TweenService:Create(
		biomeName,

		TweenInfo.new(
			HIDE_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),

		{
			TextTransparency = 1
		}

	):Play()

	TweenService:Create(
		recommended,

		TweenInfo.new(
			HIDE_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),

		{
			TextTransparency = 1
		}

	):Play()

	--------------------------------------------------
	-- PANEL HIDE
	--------------------------------------------------

	local tween = TweenService:Create(
		panel,

		TweenInfo.new(
			HIDE_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),

		{
			Position = UDim2.new(0.5, 0, 0, 5),
			BackgroundTransparency = 1
		}

	)

	tween:Play()

	tween.Completed:Wait()

	if not showing then
		panel.Visible = false
	end

end

--------------------------------------------------
-- EVENT
--------------------------------------------------

event.OnClientEvent:Connect(function(data)

	--------------------------------------------------
	-- SERVER TRAŽI DA SE UI SAKRIJE
	--------------------------------------------------

	if not data.Visible then

		if hideTask then
			task.cancel(hideTask)
			hideTask = nil
		end

		hidePanel()

		return

	end

	--------------------------------------------------
	-- UPDATE BIOME NAME
	--------------------------------------------------

	biomeName.Text = string.upper(
		data.BiomeName or "UNKNOWN BIOME"
	)

	--------------------------------------------------
	-- UPDATE RECOMMENDED SPEED
	--------------------------------------------------

	local speed = data.RecommendedSpeed or 0

	recommended.Text =
		"Recommended Speed  •  "
		.. formatSpeed(speed)

	--------------------------------------------------
	-- CANCEL OLD AUTO HIDE
	--------------------------------------------------

	if hideTask then
		task.cancel(hideTask)
		hideTask = nil
	end

	--------------------------------------------------
	-- SHOW UI
	--------------------------------------------------

	if not panel.Visible then
		showPanel()
	else
		showing = true

		panel.Position = UDim2.new(0.5, 0, 0, 18)
		panel.BackgroundTransparency = 0.28

		biomeName.TextTransparency = 0
		recommended.TextTransparency = 0
	end

	--------------------------------------------------
	-- AUTO HIDE
	--------------------------------------------------

	hideTask = task.delay(AUTO_HIDE_TIME, function()

		hideTask = nil

		if panel.Visible then
			hidePanel()
		end

	end)

end)

--------------------------------------------------
-- READY
--------------------------------------------------

event:FireServer("Ready")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="56">
          <Properties>
            <string name="Name">CustomMovementAnimations</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local player = Players.LocalPlayer

local RUN_ANIMATION_ID = "rbxassetid://110696808533851"
local WALK_ANIMATION_ID = "rbxassetid://507777826"

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animate = character:WaitForChild("Animate")

	local run = animate:FindFirstChild("run")

	if not run then
		warn("Run animation nije pronađena")
		return
	end

	local runAnim = run:FindFirstChild("RunAnim")

	if not runAnim then
		warn("RunAnim nije pronađen")
		return
	end

	runAnim.AnimationId = player:GetAttribute("SlowMode") and WALK_ANIMATION_ID or RUN_ANIMATION_ID
end

if player.Character then
	setupCharacter(player.Character)
end

player.CharacterAdded:Connect(setupCharacter)

player:GetAttributeChangedSignal("SlowMode"):Connect(function()
	if player.Character then
		setupCharacter(player.Character)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="57">
          <Properties>
            <string name="Name">EggPlacement</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Placement = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("EggPlacement"))
local remote = ReplicatedStorage:WaitForChild("PlaceEggEvent", 10)
if not remote or not remote:IsA("RemoteEvent") then
	warn("[EggPlacement] PlaceEggEvent missing. Stop Play, sync Rojo including default.project.json, then start a new session.")
	return
end
task.delay(10, function()
	if not remote:GetAttribute("ServerReady") then
		warn("[EggPlacement] Server is not ready. Check ServerScriptService.Server.EggPlacementSystem and earlier server Output errors.")
	end
end)
local ghost, equipped, size, point
local valid = false
local lastColor
local gray = Color3.fromRGB(175, 175, 175)
local red = Color3.fromRGB(235, 65, 65)

local function clear()
	if ghost then ghost:Destroy() end
	ghost, equipped, size, point, lastColor = nil, nil, nil, nil, nil
	valid = false
end

local function makePreview(tool)
	clear()
	local visual = tool:FindFirstChild("EggVisual")
	if not visual then return end
	ghost = visual:Clone()
	ghost.Name = "LocalEggPlacementPreview"
	for _, object in ipairs(ghost:GetDescendants()) do
		if object:IsA("JointInstance") or object:IsA("Constraint") or object:IsA("LuaSourceContainer")
			or object:IsA("SurfaceAppearance") or object:IsA("Decal") or object:IsA("Texture")
			or object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
			or object:IsA("Light") or object:IsA("BillboardGui") or object:IsA("SurfaceGui")
			or object:IsA("Highlight") then
			object:Destroy()
		elseif object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
			object.Transparency = if object.Transparency >= 1 then 1 else 0.6
			object.Material = Enum.Material.SmoothPlastic
			object.Reflectance = 0
			object.CastShadow = false
			if object:IsA("UnionOperation") then object.UsePartColor = true end
			if object:IsA("MeshPart") then object.TextureID = "" end
		elseif object:IsA("SpecialMesh") then
			object.TextureId = ""
			object.VertexColor = Vector3.new(1, 1, 1)
		end
	end
	ghost:PivotTo(CFrame.new())
	local _, bounds = ghost:GetBoundingBox()
	size = bounds
	equipped = tool
	ghost.Parent = workspace
end

local function updatePreview()
	valid = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool or not tool:GetAttribute("IsEggTool") or not root or not humanoid or humanoid.Health <= 0 then
		if ghost then clear() end
		return
	end
	if equipped ~= tool then makePreview(tool) end
	if not ghost then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	-- Roblox supplies the cursor ray in the correct screen coordinate space.
	-- Do not subtract GUI inset from viewport coordinates manually.
	local ray = mouse.UnitRay
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character, ghost}
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	point = if hit then hit.Position else ray.Origin + ray.Direction * 30
	local plots = workspace:FindFirstChild("Plots")
	local name = player:GetAttribute("PlotName")
	local plot = plots and type(name) == "string" and plots:FindFirstChild(name)
	local place = plot and plot:FindFirstChild("Place")
	valid = remote:GetAttribute("ServerReady") == true and hit ~= nil and place ~= nil and hit.Instance == place
		and plot:GetAttribute("OwnerUserId") == player.UserId
		and Placement.IsValid(plot, point, size, root.Position)
	local frame = if place and hit and hit.Instance == place
		then Placement.GetFrame(place, point, size)
		else CFrame.new(point + Vector3.new(0, size.Y / 2, 0))
	Placement.Move(ghost, frame)
	local color = if valid then gray else red
	if color ~= lastColor then
		for _, object in ipairs(ghost:GetDescendants()) do
			if object:IsA("BasePart") then object.Color = color end
		end
		lastColor = color
	end
end

RunService:BindToRenderStep("EggPlacementPreview", Enum.RenderPriority.Camera.Value + 1, updatePreview)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	-- Recompute at click time rather than sending the previous rendered frame's point.
	updatePreview()
	if valid and equipped and equipped.Parent == player.Character and point then
		remote:FireServer(equipped:GetAttribute("UID"), point)
	end
end)

player.CharacterRemoving:Connect(clear)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">GamePolish</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("PolishConfig"))
local NumberFormatter = require(ReplicatedStorage.Modules:WaitForChild("NumberFormatter"))

local POP = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local STUDS = "rbxassetid://6927295847"

local function playSound(id, volume, speed)
	if type(id) ~= "string" or id == "" then return nil end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.35
	sound.PlaybackSpeed = speed or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 6)
	return sound
end

-- HUD: server attributes remain the source of truth.
local gui = Instance.new("ScreenGui")
gui.Name = "PolishHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 15
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

local hud = Instance.new("Frame")
hud.Name = "RateHUD"
hud.AnchorPoint = Vector2.new(1, 0)
hud.Position = UDim2.new(1, -22, 0, 18)
hud.Size = UDim2.fromOffset(245, 72)
hud.BackgroundColor3 = Color3.fromRGB(26, 29, 42)
hud.BorderSizePixel = 0
hud.Parent = gui

local hudCorner = Instance.new("UICorner")
hudCorner.CornerRadius = UDim.new(0, 13)
hudCorner.Parent = hud
local hudStroke = Instance.new("UIStroke")
hudStroke.Color = Color3.fromRGB(15, 15, 18)
hudStroke.Thickness = 3
hudStroke.Parent = hud

local texture = Instance.new("ImageLabel")
texture.Name = "Studs"
texture.Size = UDim2.fromScale(1, 1)
texture.BackgroundTransparency = 1
texture.Image = STUDS
texture.ImageTransparency = 0.78
texture.ScaleType = Enum.ScaleType.Tile
texture.TileSize = UDim2.fromOffset(54, 54)
texture.ZIndex = 0
texture.Parent = hud
local textureCorner = Instance.new("UICorner")
textureCorner.CornerRadius = hudCorner.CornerRadius
textureCorner.Parent = texture

local function rateLabel(name, position, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Position = position
	label.Size = UDim2.new(1, -24, 0, 27)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.TextSize = 19
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 2
	label.Parent = hud
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 2
	stroke.Parent = label
	return label
end

local cashRate = rateLabel("CashPerSecond", UDim2.fromOffset(13, 8), Color3.fromRGB(92, 255, 116))
local speedRate = rateLabel("SpeedPerSecond", UDim2.fromOffset(13, 37), Color3.fromRGB(85, 190, 255))

local banner = Instance.new("TextLabel")
banner.Name = "EventBanner"
banner.AnchorPoint = Vector2.new(0.5, 0.5)
banner.Position = UDim2.fromScale(0.5, 0.25)
banner.Size = UDim2.fromOffset(430, 64)
banner.BackgroundTransparency = 1
banner.Font = Enum.Font.FredokaOne
banner.TextColor3 = Color3.new(1, 1, 1)
banner.TextStrokeColor3 = Color3.new(0, 0, 0)
banner.TextStrokeTransparency = 0
banner.TextScaled = true
banner.TextTransparency = 1
banner.ZIndex = 100
banner.Parent = gui
local bannerScale = Instance.new("UIScale")
bannerScale.Scale = 0.75
bannerScale.Parent = banner

gui.Parent = playerGui

local function refreshRates()
	cashRate.Text = "$" .. NumberFormatter.Format(player:GetAttribute("CashPerSecond")) .. " / sec"
	local training = tonumber(player:GetAttribute("TrainingSpeedPerSecond")) or 0
	speedRate.Text = if training > 0 then "+" .. NumberFormatter.Format(training) .. " Speed / sec" else "Speed training: idle"
	speedRate.TextColor3 = if training > 0 then Color3.fromRGB(85, 190, 255) else Color3.fromRGB(170, 178, 195)
end

player:GetAttributeChangedSignal("CashPerSecond"):Connect(refreshRates)
player:GetAttributeChangedSignal("TrainingSpeedPerSecond"):Connect(refreshRates)
refreshRates()

local bannerGeneration = 0
local function showBanner(text, color)
	bannerGeneration += 1
	local generation = bannerGeneration
	banner.Text = text
	banner.TextColor3 = color
	banner.TextTransparency = 1
	bannerScale.Scale = 0.72
	TweenService:Create(banner, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
	TweenService:Create(bannerScale, POP, { Scale = 1 }):Play()
	task.delay(1.25, function()
		if generation ~= bannerGeneration then return end
		TweenService:Create(banner, TweenInfo.new(0.28), { TextTransparency = 1 }):Play()
		TweenService:Create(bannerScale, TweenInfo.new(0.28), { Scale = 1.12 }):Play()
	end)
end

local function floatingText(text, color, position)
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = position
	label.Size = UDim2.fromOffset(230, 42)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.TextSize = 25
	label.TextStrokeTransparency = 0
	label.ZIndex = 90
	label.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 0.72
	scale.Parent = label
	TweenService:Create(scale, POP, { Scale = 1 }):Play()
	TweenService:Create(label, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = position - UDim2.fromOffset(0, 65),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(label, 0.9)
end

-- Floating Cash and Speed are derived from replicated stat deltas, never awarded here.
task.spawn(function()
	local stats = player:WaitForChild("Stats", 20)
	if not stats then return end
	local cash = stats:WaitForChild("Cash", 10)
	local speed = stats:WaitForChild("Speed", 10)
	local oldCash = cash and cash.Value or 0
	local oldSpeed = speed and speed.Value or 0
	if cash then
		cash.Changed:Connect(function(value)
			local delta = value - oldCash
			oldCash = value
			if delta > 0 and (tonumber(player:GetAttribute("CashPerSecond")) or 0) > 0 then
				floatingText("+$" .. NumberFormatter.Format(delta), Color3.fromRGB(92, 255, 116), UDim2.new(1, -145, 0, 112))
			end
		end)
	end
	if speed then
		speed.Changed:Connect(function(value)
			local delta = value - oldSpeed
			oldSpeed = value
			if delta > 0 and (tonumber(player:GetAttribute("TrainingSpeedPerSecond")) or 0) > 0 then
				floatingText("+" .. NumberFormatter.Format(delta) .. " SPEED", Color3.fromRGB(85, 190, 255), UDim2.fromScale(0.5, 0.72))
			end
		end)
	end
end)

local function animateOpen(screenGui)
	if screenGui == gui or not screenGui.Enabled then return end
	local root = screenGui:FindFirstChildWhichIsA("GuiObject")
	if not root then return end
	local scale = root:FindFirstChild("PolishOpenScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "PolishOpenScale"
		scale.Parent = root
	end
	scale.Scale = 0.9
	TweenService:Create(scale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function registerGui(child)
	if not child:IsA("ScreenGui") or child == gui then return end
	child:GetPropertyChangedSignal("Enabled"):Connect(function()
		if child.Enabled then animateOpen(child) end
	end)
end

for _, child in ipairs(playerGui:GetChildren()) do registerGui(child) end
playerGui.ChildAdded:Connect(registerGui)

local function rarityColor(rarity)
	return Config.RarityColors[rarity] or Color3.new(1, 1, 1)
end

local function hatchBurst(monster, rarity, isOwner)
	if not monster or not monster:IsA("Model") or not monster.Parent then return end
	local primary = monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart", true)
	if not primary then return end
	local color = rarityColor(rarity)
	local highlight = Instance.new("Highlight")
	highlight.Name = "HatchHighlight"
	highlight.FillColor = color
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.15
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = monster
	TweenService:Create(highlight, TweenInfo.new(0.9), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	Debris:AddItem(highlight, 1)

	local attachment = Instance.new("Attachment")
	attachment.Name = "HatchBurst"
	attachment.Parent = primary
	local particles = Instance.new("ParticleEmitter")
	particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	particles.LightEmission = 0.7
	particles.Lifetime = NumberRange.new(0.55, 1.1)
	particles.Speed = NumberRange.new(6, 12)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Drag = 3
	particles.Rate = 0
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(1, 0),
	})
	particles.Parent = attachment
	particles:Emit(Config.RarityBurstCount[rarity] or 20)
	Debris:AddItem(attachment, 1.5)
	if isOwner then
		showBanner(string.upper(tostring(rarity)) .. " HATCH!", color)
		playSound(Config.Sounds.Hatch, 0.5, 0.9 + math.random() * 0.2)
	end
end

local polishEvent = ReplicatedStorage:WaitForChild("PolishEvent", 20)
if polishEvent and polishEvent:IsA("RemoteEvent") then
	polishEvent.OnClientEvent:Connect(function(action, monster, rarity, ownerUserId)
		if action == "Hatch" then
			hatchBurst(monster, rarity, ownerUserId == player.UserId)
		end
	end)
end

local chaseSound
local runEvent = ReplicatedStorage:WaitForChild("RunUIEvent", 20)
if runEvent and runEvent:IsA("RemoteEvent") then
	runEvent.OnClientEvent:Connect(function(running, reason)
		local camera = workspace.CurrentCamera
		if running then
			showBanner("RUN!", Color3.fromRGB(255, 67, 67))
			playSound(Config.Sounds.Pickup, 0.45, 1)
			if camera then TweenService:Create(camera, TweenInfo.new(0.25), { FieldOfView = 76 }):Play() end
			if Config.Sounds.ChaseMusicId ~= "" and not chaseSound then
				chaseSound = Instance.new("Sound")
				chaseSound.Name = "ChaseMusic"
				chaseSound.SoundId = Config.Sounds.ChaseMusicId
				chaseSound.Volume = 0.45
				chaseSound.Looped = true
				chaseSound.Parent = SoundService
				chaseSound:Play()
			end
		else
			if camera then TweenService:Create(camera, TweenInfo.new(0.35), { FieldOfView = 70 }):Play() end
			if chaseSound then chaseSound:Destroy(); chaseSound = nil end
			if reason == "Deposited" then
				showBanner("EGG SECURED!", Color3.fromRGB(92, 255, 116))
				playSound(Config.Sounds.Deposit, 0.45, 1)
			end
		end
	end)
end

-- Floating income above owned monsters. Visual only; IncomeService performs payment.
task.spawn(function()
	while gui.Parent do
		task.wait(3)
		local shown = 0
		for _, monster in ipairs(workspace:GetDescendants()) do
			if shown >= 16 then break end
			if monster:IsA("Model") and monster:GetAttribute("IsMonster") == true
				and monster:GetAttribute("OwnerUserId") == player.UserId then
				local income = tonumber(monster:GetAttribute("FinalIncome")) or 0
				local primary = monster.PrimaryPart
				if primary and income > 0 then
					shown += 1
					local bill = Instance.new("BillboardGui")
					bill.Name = "IncomeFloat"
					bill.Adornee = primary
					bill.Size = UDim2.fromOffset(150, 40)
					bill.StudsOffsetWorldSpace = Vector3.new(math.random(-10, 10) / 10, 3, 0)
					bill.AlwaysOnTop = true
					bill.MaxDistance = 90
					bill.Parent = primary
					local text = Instance.new("TextLabel")
					text.Size = UDim2.fromScale(1, 1)
					text.BackgroundTransparency = 1
					text.Font = Enum.Font.FredokaOne
					text.Text = "+$" .. NumberFormatter.Format(income)
					text.TextColor3 = Color3.fromRGB(92, 255, 116)
					text.TextSize = 22
					text.TextStrokeTransparency = 0
					text.Parent = bill
					TweenService:Create(bill, TweenInfo.new(1), { StudsOffsetWorldSpace = bill.StudsOffsetWorldSpace + Vector3.new(0, 2, 0) }):Play()
					TweenService:Create(text, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
					Debris:AddItem(bill, 1.05)
				end
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="59">
          <Properties>
            <string name="Name">GuardianRagdoll</string>
            <string name="Source"><![CDATA[-- Match the local Humanoid/animation controller to the server's hit state.
-- The client never decides who gets hit or the launch velocity.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local connection, stepConnection
	local saved = nil
	local function restore()
		if stepConnection then stepConnection:Disconnect(); stepConnection = nil end
		if not saved then return end
		for motor, enabled in pairs(saved.motors) do
			if motor.Parent then motor.Enabled = enabled end
		end
		if saved.animate and saved.animate.Parent then saved.animate.Enabled = saved.animateEnabled end
		if humanoid.Parent then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, saved.gettingUp)
			humanoid.PlatformStand = false
			if humanoid.Health > 0 then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
		end
		saved = nil
	end
	local function update()
		if character:GetAttribute("GuardianRagdoll") ~= true then restore(); return end
		if saved then return end
		local animate = character:FindFirstChild("Animate")
		saved = { motors = {}, gettingUp = humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp), animate = nil }
		if animate and animate:IsA("LocalScript") then
			saved.animate, saved.animateEnabled = animate, animate.Enabled
			animate.Enabled = false
		end
		-- Server tags only originally enabled body motors belonging to this hit.
		local function enforce()
			for _, joint in ipairs(character:GetDescendants()) do
				if (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint"))
					and joint:GetAttribute("GuardianRagdollMotor") == true then
					saved.motors[joint] = true
					joint.Enabled = false
				end
			end
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
			end
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			humanoid.PlatformStand = true
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end
		enforce()
		stepConnection = RunService.PreSimulation:Connect(enforce)
	end
	connection = character:GetAttributeChangedSignal("GuardianRagdoll"):Connect(update)
	local removing
	removing = player.CharacterRemoving:Connect(function(oldCharacter)
		if oldCharacter ~= character then return end
		connection:Disconnect()
		restore()
		removing:Disconnect()
	end)
	update()
end

player.CharacterAdded:Connect(setup)
if player.Character then task.spawn(setup, player.Character) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="60">
          <Properties>
            <string name="Name">IndexUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("MonsterConfig"))
local NumberFormatter = require(ReplicatedStorage.Modules:WaitForChild("NumberFormatter"))
local unlocks = player:WaitForChild("IndexUnlocks")
local previews = ReplicatedStorage:WaitForChild("IndexPreviews")
local playerGui = player:WaitForChild("PlayerGui")
local biomeNames = { "Hatchling Fields", "Bio Marsh", "Spore Lab", "Volcano", "Cryo Sector", "Fossil Lab", "Mutation Core", "Cosmic Incubator" }
local sectionBiomes = { "HatchlingFields", "BioMarsh", "SporeLab", "Volcano", "CryoSector", "FossilLab", "MutationCore", "CosmicIncubator" }
local rarityOrder = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6 }
local catalog = {}
for id, definition in pairs(Config.Definitions) do table.insert(catalog, { id = id, definition = definition }) end
table.sort(catalog, function(a, b)
	local ra, rb = rarityOrder[a.definition.Rarity], rarityOrder[b.definition.Rarity]
	if ra ~= rb then return ra < rb end
	return a.definition.IndexId < b.definition.IndexId
end)
local currentGui, refresh
local connections = {}

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
end

local function viewport(holder, id, unlocked)
	local old = holder:FindFirstChild("IndexViewport")
	if old then old:Destroy() end
	local question = holder:FindFirstChild("QuestionMark")
	if question then question.Visible = not unlocked end
	local image = holder:FindFirstChild("MonsterImage")
	if image then image.Visible = false end
	if not unlocked then return end
	local source = previews:FindFirstChild(id)
	if not source then return end
	local view = Instance.new("ViewportFrame")
	view.Name = "IndexViewport"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	view.ZIndex = holder.ZIndex + 1
	view.Ambient = Color3.fromRGB(200, 200, 200)
	view.LightColor = Color3.new(1, 1, 1)
	local world = Instance.new("WorldModel")
	world.Parent = view
	local model = source:Clone()
	model.Parent = world
	local frame, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	local distance = size.Magnitude / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.15
	camera.CFrame = CFrame.lookAt(frame.Position + Vector3.new(0.25, 0.15, -1).Unit * distance, frame.Position)
	camera.Parent = view
	view.CurrentCamera = camera
	view.Parent = holder
end

local function bind(gui)
	if currentGui == gui then return end
	for _, connection in ipairs(connections) do connection:Disconnect() end
	connections = {}
	currentGui, refresh = gui, nil
	local frame = gui:WaitForChild("Frame", 10)
	local bottom = frame and frame:WaitForChild("BottomFrame", 10)
	local details = bottom and bottom:FindFirstChild("MonsterDetails")
	local scroller = bottom and bottom:FindFirstChild("BiomeScroller")
	if not details or not scroller then warn("[IndexUI] Missing MonsterDetails/BiomeScroller"); return end
	-- Reuse the user's styles and reserve separate rows for the two new fields.
	for _, name in ipairs({"BaseIncome", "BestSizeFound"}) do
		if not details:FindFirstChild(name) then
			local label = details.Biome:Clone()
			label.Name = name
			label.Parent = details
		end
	end
	local rows = { MonsterName = 0.44, Rarity = 0.54, Biome = 0.62, BaseIncome = 0.70, BestSizeFound = 0.78, Status = 0.88 }
	details.ImageHolder.Position = UDim2.fromScale(0.1, 0.03)
	details.ImageHolder.Size = UDim2.fromScale(0.8, 0.39)
	details.ImageHolder.AnchorPoint = Vector2.zero
	for name, y in pairs(rows) do
		local label = details:FindFirstChild(name)
		if label then
			label.AnchorPoint = Vector2.zero
			label.Position = UDim2.fromScale(0.05, y)
			label.Size = UDim2.fromScale(0.9, if name == "MonsterName" then 0.09 else 0.07)
			label.TextScaled = true
			label.TextWrapped = true
		end
	end
	local selected
	local bindings = {}
	local sections = {}
	for index, biome in ipairs(sectionBiomes) do
		local section = scroller:FindFirstChild("BiomeSection_" .. index)
		if not section then continue end
		local entries = {}
		for _, entry in ipairs(catalog) do if entry.definition.Biome == biome then table.insert(entries, entry) end end
		section.BiomePreview.BiomeName.Text = biomeNames[index]
		section.Visible = #entries > 0
		table.insert(sections, { section = section, entries = entries })
		local area = section.CreatureArea
		local template = area:FindFirstChild("CreatureSlot_1")
		for _, slot in ipairs(area:GetChildren()) do
			if slot:IsA("GuiObject") and slot.Name:match("^CreatureSlot_") then slot.Visible = false end
		end
		for slotIndex, entry in ipairs(entries) do
			local slot = area:FindFirstChild("CreatureSlot_" .. slotIndex)
			if not slot and template then slot = template:Clone(); slot.Name = "CreatureSlot_" .. slotIndex; slot.Parent = area end
			if not slot then continue end
			slot.Visible, slot.LayoutOrder = true, slotIndex
			local button = slot:FindFirstChild("IndexSelect") or Instance.new("TextButton")
			button.Name = "IndexSelect"
			button.Size = UDim2.fromScale(1, 1)
			button.BackgroundTransparency = 1
			button.Text = ""
			button.ZIndex = slot.ImageArea.ZIndex + 5
			button.Parent = slot
			connect(button.Activated, function() selected = entry; if refresh then refresh() end end)
			table.insert(bindings, { slot = slot, entry = entry })
		end
	end
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.X
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	refresh = function()
		if currentGui ~= gui or not gui.Parent then return end
		local count = 0
		for _, entry in ipairs(catalog) do if unlocks:FindFirstChild(entry.definition.IndexId) then count += 1 end end
		bottom.UnlockedBar.UnlockedText.Text = string.format("Unlocked: %d/%d", count, #catalog)
		local status = player:GetAttribute("IndexDataStatus")
		if status == "LoadFailed" then bottom.UnlockedBar.UnlockedText.Text ..= " (session only)"
		elseif status == "SaveFailed" then bottom.UnlockedBar.UnlockedText.Text ..= " (save pending)" end
		for _, info in ipairs(sections) do
			local found = 0
			for _, entry in ipairs(info.entries) do if unlocks:FindFirstChild(entry.definition.IndexId) then found += 1 end end
			info.section.BiomePreview.Progress.Text = string.format("%d/%d", found, #info.entries)
		end
		for _, info in ipairs(bindings) do
			local def = info.entry.definition
			local unlocked = unlocks:FindFirstChild(def.IndexId) ~= nil
			info.slot.CreatureName.Text = if unlocked then def.MonsterName else "???"
			viewport(info.slot.ImageArea, def.IndexId, unlocked)
		end
		local def = selected and selected.definition
		local record = def and unlocks:FindFirstChild(def.IndexId)
		details.MonsterName.Text = if record then def.MonsterName elseif def then "???" else "Select a Creature"
		details.Rarity.Text = if record then def.Rarity else "???"
		details.Biome.Text = "Biome: " .. (if record then (if def.Biome == "HatchlingFields" then "Hatchling Fields" else def.Biome) else "???")
		details.BaseIncome.Text = if record then "Base Income: $" .. NumberFormatter.Format(def.BaseIncome) .. "/sec" else "Base Income: ???"
		details.BestSizeFound.Text = "Best Size Found: " .. (if record then record:GetAttribute("BestSizeFound") or "???" else "???")
		details.Status.Text = if record then "UNLOCKED" elseif def then "LOCKED" else "SELECT A CREATURE"
		viewport(details.ImageHolder, if def then def.IndexId else "", record ~= nil)
	end
	connect(frame.TopFrame.ExitButton.Activated, function() frame.Visible = false end)
	refresh()
end

local function changed() if refresh then refresh() end end
player:GetAttributeChangedSignal("IndexDataStatus"):Connect(changed)
local recordConnections = {}
local function watch(record)
	recordConnections[record] = record:GetAttributeChangedSignal("BestSizeFound"):Connect(changed)
	changed()
end
unlocks.ChildAdded:Connect(watch)
unlocks.ChildRemoved:Connect(function(record)
	if recordConnections[record] then recordConnections[record]:Disconnect(); recordConnections[record] = nil end
	changed()
end)
for _, record in ipairs(unlocks:GetChildren()) do watch(record) end
playerGui.ChildAdded:Connect(function(gui) if gui.Name == "IndexUi" then task.spawn(bind, gui) end end)
playerGui.ChildRemoved:Connect(function(gui)
	if gui == currentGui then
		for _, connection in ipairs(connections) do connection:Disconnect() end
		connections, currentGui, refresh = {}, nil, nil
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.I then return end
	local gui = currentGui
	local frame = gui and gui:FindFirstChild("Frame")
	if frame then gui.Enabled = true; frame.Visible = not frame.Visible end
end)
local existing = playerGui:FindFirstChild("IndexUi")
if existing then task.spawn(bind, existing) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">LavaAnimation (Thermal Chamber)</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local lavaFloor = workspace:FindFirstChild("LavaFloor")
if not lavaFloor then
	warn("[LavaAnimation] Workspace.LavaFloor nije pronađen; animacija lave je preskočena.")
	return
end

local texture = lavaFloor:FindFirstChild("Texture")
local light = lavaFloor:FindFirstChild("SurfaceLight")
if not texture or not texture:IsA("Texture") or not light or not light:IsA("SurfaceLight") then
	warn("[LavaAnimation] LavaFloor mora imati Texture i SurfaceLight; animacija lave je preskočena.")
	return
end

-- =========================
-- POMERANJE LAVE
-- =========================

local MOVE_SPEED_U = 0.6
local MOVE_SPEED_V = 0.18

-- =========================
-- PULSIRANJE SVETLA
-- =========================

local BASE_BRIGHTNESS = 0.8
local BRIGHTNESS_PULSE = 0.35

-- =========================
-- PULSIRANJE TEKSTURE
-- =========================

local BASE_TRANSPARENCY = 0.02
local TRANSPARENCY_PULSE = 0.08

-- Brzina pulsiranja
local PULSE_SPEED_1 = 1.3
local PULSE_SPEED_2 = 2.1

-- =========================
-- START VREDNOSTI
-- =========================

local timePassed = 0
local offsetU = texture.OffsetStudsU
local offsetV = texture.OffsetStudsV

-- =========================
-- ANIMACIJA
-- =========================

RunService.RenderStepped:Connect(function(dt)
	timePassed += dt

	-- Pomeranje lava teksture
	offsetU += MOVE_SPEED_U * dt
	offsetV += MOVE_SPEED_V * dt

	texture.OffsetStudsU = offsetU
	texture.OffsetStudsV = offsetV

	-- Nepravilan heat pulse
	local wave1 = math.sin(timePassed * PULSE_SPEED_1)
	local wave2 = math.sin(timePassed * PULSE_SPEED_2)

	local pulse = wave1 * 0.7 + wave2 * 0.3

	-- Pretvaramo otprilike u 0 - 1e
	pulse = (pulse + 1) / 2

	-- Pulsiranje SurfaceLight-a
	light.Brightness =
		BASE_BRIGHTNESS + pulse * BRIGHTNESS_PULSE

	-- Pulsiranje same teksture
	-- Kad je pulse jači, lava je manje providna
	texture.Transparency =
		BASE_TRANSPARENCY + (1 - pulse) * TRANSPARENCY_PULSE
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="62">
          <Properties>
            <string name="Name">MonsterAnimations</string>
            <string name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")

local tracked = setmetatable({}, { __mode = "k" })
local pending = setmetatable({}, { __mode = "k" })

local function animationFor(monster)
	local embedded = monster:FindFirstChild("WalkAnimation", true)
	if embedded and embedded:IsA("Animation") and embedded.AnimationId ~= "" then
		return embedded
	end

	local animationId = monster:GetAttribute("WalkAnimationId")
	if type(animationId) == "number" then animationId = tostring(animationId) end
	if type(animationId) ~= "string" or animationId == "" then return nil end
	if not string.find(animationId, "^rbxassetid://") then animationId = "rbxassetid://" .. animationId end

	local animation = Instance.new("Animation")
	animation.Name = "RuntimeWalkAnimation"
	animation.AnimationId = animationId
	animation.Parent = monster
	return animation
end

local function animatorFor(monster)
	local humanoid = monster:FindFirstChildWhichIsA("Humanoid", true)
	local controller = humanoid or monster:FindFirstChildWhichIsA("AnimationController", true)
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Name = "MonsterAnimationController"
		controller.Parent = monster
	end
	local animator = controller:FindFirstChildWhichIsA("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return animator
end

local function register(monster)
	if tracked[monster] or not monster:IsA("Model") or monster:GetAttribute("IsMonster") ~= true then return end
	local animation = animationFor(monster)
	if not animation then
		-- Replication can deliver the Model before its Animation child. Retry briefly
		-- so the animation is not missed just because of that ordering.
		if pending[monster] then return end
		pending[monster] = true
		task.spawn(function()
			for _, delaySeconds in ipairs({ 0.1, 0.4, 1, 2, 4 }) do
				task.wait(delaySeconds)
				if not monster.Parent or tracked[monster] then break end
				if animationFor(monster) then
					pending[monster] = nil
					register(monster)
					return
				end
			end
			pending[monster] = nil
		end)
		return
	end

	local animator = animatorFor(monster)
	task.spawn(function()
		pcall(ContentProvider.PreloadAsync, ContentProvider, { animation })
	end)
	local ok, track = pcall(animator.LoadAnimation, animator, animation)
	if not ok then
		warn("[MonsterAnimations] Walk animation could not load for " .. monster.Name .. ": " .. tostring(track))
		return
	end
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Movement
	track:AdjustSpeed(1)

	local function refresh()
		if monster:GetAttribute("WanderState") == "Walking" then
			if not track.IsPlaying then track:Play(0.15) end
		elseif track.IsPlaying then
			track:Stop(0.15)
		end
	end

	local stateConnection = monster:GetAttributeChangedSignal("WanderState"):Connect(refresh)
	local ancestryConnection
	ancestryConnection = monster.AncestryChanged:Connect(function(_, parent)
		if parent then return end
		stateConnection:Disconnect()
		ancestryConnection:Disconnect()
		track:Stop(0)
		tracked[monster] = nil
	end)
	tracked[monster] = true
	refresh()
end

for _, descendant in ipairs(workspace:GetDescendants()) do register(descendant) end
workspace.DescendantAdded:Connect(function(descendant)
	register(descendant)
	local model = descendant:FindFirstAncestorOfClass("Model")
	if model then register(model) end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">OfflineIncomeUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NumberFormatter = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("NumberFormatter"))

local shown = false

local function formatDuration(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if hours > 0 then return string.format("%dh %02dm", hours, minutes) end
	return string.format("%dm", math.max(1, minutes))
end

local function showOfflineIncome()
	if shown or player:GetAttribute("PlayerDataStatus") ~= "Ready" then return end
	local amount = tonumber(player:GetAttribute("OfflineIncomeAmount")) or 0
	local seconds = tonumber(player:GetAttribute("OfflineIncomeSeconds")) or 0
	if amount <= 0 or seconds <= 0 then return end
	shown = true

	local gui = Instance.new("ScreenGui")
	gui.Name = "OfflineIncomeUi"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.fromScale(0.5, 0.08)
	frame.Size = UDim2.fromOffset(390, 92)
	frame.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
	frame.BackgroundTransparency = 0.08
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 205, 70)
	stroke.Thickness = 2
	stroke.Parent = frame
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 22
	label.TextWrapped = true
	label.Text = string.format("Welcome back!\nYou earned $%s in %s", NumberFormatter.Format(amount), formatDuration(seconds))
	label.Parent = frame
	gui.Parent = player:WaitForChild("PlayerGui")
	task.delay(8, function() if gui.Parent then gui:Destroy() end end)
end

player:GetAttributeChangedSignal("PlayerDataStatus"):Connect(showOfflineIncome)
player:GetAttributeChangedSignal("OfflineIncomeAmount"):Connect(showOfflineIncome)
player:GetAttributeChangedSignal("OfflineIncomeSeconds"):Connect(showOfflineIncome)
task.defer(showOfflineIncome)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="64">
          <Properties>
            <string name="Name">PlotUpgradeUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NumberFormatter = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("NumberFormatter"))

local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("PlotUpgradeEvent", 15)
if not event then warn("[PlotUpgradeUI] PlotUpgradeEvent was not initialized"); return end

local gui = Instance.new("ScreenGui")
gui.Name = "PlotUpgradeUi"
gui.ResetOnSpawn = false
gui.DisplayOrder = 20

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -24, 0.5, 0)
panel.Size = UDim2.fromOffset(270, 132)
panel.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
panel.BackgroundTransparency = 0.08
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(115, 205, 255)
stroke.Thickness = 2
stroke.Parent = panel

local title = Instance.new("TextLabel")
title.Position = UDim2.fromOffset(12, 8)
title.Size = UDim2.new(1, -24, 0, 28)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.Text = "PLOT CAPACITY"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 19
title.Parent = panel

local capacityLabel = Instance.new("TextLabel")
capacityLabel.Position = UDim2.fromOffset(12, 38)
capacityLabel.Size = UDim2.new(1, -24, 0, 24)
capacityLabel.BackgroundTransparency = 1
capacityLabel.Font = Enum.Font.GothamMedium
capacityLabel.TextColor3 = Color3.fromRGB(205, 220, 235)
capacityLabel.TextSize = 16
capacityLabel.Parent = panel

local button = Instance.new("TextButton")
button.Position = UDim2.fromOffset(12, 70)
button.Size = UDim2.new(1, -24, 0, 48)
button.BackgroundColor3 = Color3.fromRGB(55, 165, 225)
button.AutoButtonColor = true
button.Font = Enum.Font.GothamBold
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 17
button.Parent = panel
local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 10)
buttonCorner.Parent = button

local busy = false
local function refresh()
	local capacity = tonumber(player:GetAttribute("PlotCapacity")) or 6
	local nextCapacity = tonumber(player:GetAttribute("PlotUpgradeNextCapacity")) or 0
	local cost = tonumber(player:GetAttribute("PlotUpgradeCost")) or 0
	local maxed = player:GetAttribute("PlotUpgradeMaxed") == true
	local status = player:GetAttribute("PlotUpgradeStatus")
	capacityLabel.Text = string.format("Current slots: %d", capacity)
	if maxed then
		button.Text = "MAX CAPACITY (16)"
		button.BackgroundColor3 = Color3.fromRGB(80, 90, 105)
		button.Active = false
	elseif status == "NotEnoughCash" then
		button.Text = string.format("Need $%s for %d slots", NumberFormatter.Format(cost), nextCapacity)
		button.BackgroundColor3 = Color3.fromRGB(200, 75, 70)
		button.Active = true
	elseif status == "DataNotReady" then
		button.Text = "DATA NOT READY"
		button.BackgroundColor3 = Color3.fromRGB(200, 130, 55)
		button.Active = true
	else
		button.Text = string.format("UPGRADE TO %d - $%s", nextCapacity, NumberFormatter.Format(cost))
		button.BackgroundColor3 = Color3.fromRGB(55, 165, 225)
		button.Active = true
	end
	busy = false
end

button.Activated:Connect(function()
	if busy or player:GetAttribute("PlotUpgradeMaxed") == true then return end
	busy = true
	event:FireServer()
	task.delay(1, function() busy = false end)
end)

for _, attribute in ipairs({ "PlotCapacity", "PlotUpgradeNextCapacity", "PlotUpgradeCost",
	"PlotUpgradeMaxed", "PlotUpgradeStatus" }) do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
end

gui.Parent = player:WaitForChild("PlayerGui")
refresh()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="65">
          <Properties>
            <string name="Name">ShopController</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ShopConfig"))

local currentShop
local connections = {}

local function disconnectAll()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
end

local function setButtonText(button, text)
	if button:IsA("TextButton") then
		button.Text = text
		return
	end
	for _, descendant in ipairs(button:GetDescendants()) do
		if descendant:IsA("TextLabel") and string.find(string.lower(descendant.Name), "price") then
			descendant.Text = text
			return
		end
	end
end

local function setUnavailable(button, text)
	button.Active = false
	button.AutoButtonColor = false
	setButtonText(button, text)
end

local function loadPrice(button, id, infoType)
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
		if currentShop and button:IsDescendantOf(currentShop) then
			if ok and info and info.IsForSale ~= false then
				setButtonText(button, "R$ " .. tostring(info.PriceInRobux or "?"))
			else
				setUnavailable(button, "UNAVAILABLE")
			end
		end
	end)
end

local function bindProduct(section, cardName, definition)
	local card = section:FindFirstChild(cardName)
	local button = card and card:FindFirstChild("BuyButton")
	if not button or not button:IsA("GuiButton") then
		warn("[ShopController] Missing BuyButton for " .. cardName)
		return
	end
	local productName = card:FindFirstChild("ProductName")
	if productName and productName:IsA("TextLabel") and definition.DisplayName then
		productName.Text = definition.DisplayName
	end
	if type(definition.Id) ~= "number" or definition.Id <= 0 then
		setUnavailable(button, "SET PRODUCT ID")
		return
	end
	loadPrice(button, definition.Id, Enum.InfoType.Product)
	table.insert(connections, button.Activated:Connect(function()
		MarketplaceService:PromptProductPurchase(player, definition.Id)
	end))
end

local function bindPass(section, cardName, definition)
	local card = section:FindFirstChild(cardName)
	local button = card and card:FindFirstChild("BuyButton")
	if not button or not button:IsA("GuiButton") then
		warn("[ShopController] Missing BuyButton for " .. cardName)
		return
	end
	if not definition.Enabled then
		setUnavailable(button, "COMING SOON")
		return
	end
	if type(definition.Id) ~= "number" or definition.Id <= 0 then
		setUnavailable(button, "SET PASS ID")
		return
	end
	loadPrice(button, definition.Id, Enum.InfoType.GamePass)
	table.insert(connections, button.Activated:Connect(function()
		if player:GetAttribute(definition.Attribute) == true then return end
		MarketplaceService:PromptGamePassPurchase(player, definition.Id)
	end))
	local function refreshOwned()
		if player:GetAttribute(definition.Attribute) == true then
			setUnavailable(button, "OWNED")
		end
	end
	table.insert(connections, player:GetAttributeChangedSignal(definition.Attribute):Connect(refreshOwned))
	refreshOwned()
end

local function bind(shop)
	if currentShop == shop then return end
	disconnectAll()
	currentShop = shop

	local frame = shop:WaitForChild("Frame", 10)
	local bottom = frame and frame:WaitForChild("BottomFrame", 10)
	local scrolling = bottom and bottom:WaitForChild("ScrollingFrame", 10)
	local passes = scrolling and scrolling:FindFirstChild("PassesSection")
	local speed = scrolling and scrolling:FindFirstChild("SpeedSection")
	local coins = scrolling and scrolling:FindFirstChild("CoinsSection")
	if not passes or not speed or not coins then
		warn("[ShopController] Shop hierarchy is missing PassesSection, SpeedSection or CoinsSection")
		return
	end

	for cardName, definition in pairs(Config.GamePasses) do
		bindPass(passes, cardName, definition)
	end
	for cardName, definition in pairs(Config.DeveloperProducts) do
		local section = if string.find(cardName, "COINS") then coins else speed
		bindProduct(section, cardName, definition)
	end

	print("[ShopController] Existing Shop UI connected.")
end

local existing = playerGui:FindFirstChild("Shop")
if existing and existing:IsA("ScreenGui") then task.spawn(bind, existing) end
playerGui.ChildAdded:Connect(function(child)
	if child.Name == "Shop" and child:IsA("ScreenGui") then task.spawn(bind, child) end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="66">
          <Properties>
            <string name="Name">TreadmillAnimation</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character, humanoid, animator, track, animation, diedConnection
local generation = 0

local function stop()
	if track then
		track:Stop(0.15)
		track:Destroy()
		track = nil
	end
	if animation then animation:Destroy(); animation = nil end
end

local function update()
	if not player:GetAttribute("TreadmillLocked") or not humanoid or humanoid.Health <= 0
		or character ~= player.Character or not animator then
		stop()
		return
	end
	if track then return end
	-- Match the existing movement animation instead of relying on Running speed:
	-- the treadmill holds the root still, so the normal Animate script sees zero speed.
	local animate = character:FindFirstChild("Animate")
	local run = animate and animate:FindFirstChild("run")
	local source = run and run:FindFirstChildWhichIsA("Animation", true)
	local id = source and source.AnimationId
	if not id or id == "" then
		id = if humanoid.RigType == Enum.HumanoidRigType.R6
			then "rbxassetid://180426354" else "rbxassetid://110696808533851"
	end
	animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, result = pcall(function() return animator:LoadAnimation(animation) end)
	if not ok then
		warn("[TreadmillAnimation] " .. tostring(result))
		stop()
		return
	end
	track = result
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.15, 1, 1)
end

local function setup(nextCharacter)
	generation += 1
	local current = generation
	stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	character, humanoid, animator = nextCharacter, nil, nil
	local nextHumanoid = nextCharacter:WaitForChild("Humanoid", 10)
	local nextAnimator = nextHumanoid and nextHumanoid:WaitForChild("Animator", 10)
	if current ~= generation or player.Character ~= nextCharacter then return end
	if not nextHumanoid or not nextAnimator then return end
	humanoid, animator = nextHumanoid, nextAnimator
	diedConnection = humanoid.Died:Connect(stop)
	update()
end

player:GetAttributeChangedSignal("TreadmillLocked"):Connect(update)
player.CharacterAdded:Connect(setup)
player.CharacterRemoving:Connect(function()
	generation += 1
	stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	character, humanoid, animator = nil, nil, nil
end)
if player.Character then task.spawn(setup, player.Character) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="67">
          <Properties>
            <string name="Name">TreadmillControls</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("TreadmillJumpEvent", 15)
if not event then warn("[Treadmill] Server did not initialize TreadmillJumpEvent"); return end
local lastJump = 0
UserInputService.JumpRequest:Connect(function()
	if not player:GetAttribute("TreadmillLocked") then return end
	local now = os.clock()
	if now - lastJump < 0.2 then return end
	lastJump = now
	event:FireServer()
end)
event.OnClientEvent:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Jump = true
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
