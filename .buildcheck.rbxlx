      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">EggConfig</string>
          <string name="Source"><![CDATA[--!strict

-- ReplicatedStorage.Modules.EggConfig
-- Faza 4
--
-- Ovde se nalaze:
-- 1. stabilni EggType identifikatori
-- 2. display imena
-- 3. ModelName koji mora postojati u ServerStorage.EggModels
-- 4. rarity metadata
-- 5. biome egg pool-ovi
-- 6. postojeće size šanse
--
-- POOL WEIGHTS SU PODESIVI.
-- Trenutni početni balans je 60 / 30 / 10.

local EggConfig = {}

--------------------------------------------------
-- EGG DEFINITIONS
--------------------------------------------------
--
-- EggType je stabilni ID.
-- Ne menjaj postojeći EggType kasnije samo zato
-- što želiš drugo display ime ili drugi model.
--
-- EggName = ime koje vidi igrač.
-- ModelName = tačno ime Model-a u ServerStorage.EggModels.
-- Rarity = trenutno samo metadata.

EggConfig.EggTypes = {
	hatchling_egg = {
		EggType = "hatchling_egg",
		EggName = "Hatchling Egg",
		ModelName = "HatchlingEgg",
		Rarity = "Common",
	},

	forest_egg = {
		EggType = "forest_egg",
		EggName = "Forest Egg",
		ModelName = "ForestEgg",
		Rarity = "Uncommon",
	},

	slime_egg = {
		EggType = "slime_egg",
		EggName = "Slime Egg",
		ModelName = "SlimeEgg",
		Rarity = "Rare",
	},

	magma_egg = {
		EggType = "magma_egg",
		EggName = "Magma Egg",
		ModelName = "MagmaEgg",
		Rarity = "Rare",
	},

	inferno_egg = {
		EggType = "inferno_egg",
		EggName = "Inferno Egg",
		ModelName = "InfernoEgg",
		Rarity = "Epic",
	},

	dragon_egg = {
		EggType = "dragon_egg",
		EggName = "Dragon Egg",
		ModelName = "DragonEgg",
		Rarity = "Legendary",
	},
}

--------------------------------------------------
-- LEGACY FALLBACK
--------------------------------------------------
--
-- Koristi se ISKLJUČIVO kada spawn Part nema
-- Biome Attribute.
--
-- Ako Biome Attribute postoji, ali nije validan,
-- NE koristi se ovaj fallback.

EggConfig.LegacyBasicEgg = {
	EggType = "basic_egg",
	EggName = "Basic Egg",
	ModelName = "BasicEgg",
	Rarity = "Common",
	Biome = "Legacy",
}

--------------------------------------------------
-- BIOME POOLS
--------------------------------------------------
--
-- Weight vrednosti su podesive.
-- Ne moraju zbirno biti 100.
--
-- Primer:
-- 60 / 30 / 10 može kasnije biti
-- 70 / 25 / 5 bez promene EggSystem skripte.

EggConfig.BiomePools = {
	HatchlingFields = {
		{
			EggType = "hatchling_egg",
			Weight = 60,
		},
		{
			EggType = "forest_egg",
			Weight = 30,
		},
		{
			EggType = "slime_egg",
			Weight = 10,
		},
	},

	Volcano = {
		{
			EggType = "magma_egg",
			Weight = 60,
		},
		{
			EggType = "inferno_egg",
			Weight = 30,
		},
		{
			EggType = "dragon_egg",
			Weight = 10,
		},
	},
}

--------------------------------------------------
-- EXISTING SIZE CONFIG
--------------------------------------------------
--
-- Ovo su POSTOJEĆE faza 1/2 vrednosti.
-- Ne dodajemo income multiplier logiku.
--
-- Income multiplikatori su definisani u zasebnom SizeConfig modulu.

EggConfig.Sizes = {
	{
		Name = "Tiny",
		Scale = 0.7,
		Weight = 20,
	},

	{
		Name = "Normal",
		Scale = 1,
		Weight = 45,
	},

	{
		Name = "Large",
		Scale = 1.4,
		Weight = 22,
	},

	{
		Name = "Huge",
		Scale = 1.9,
		Weight = 10,
	},

	{
		Name = "Titanic",
		Scale = 2.6,
		Weight = 3,
	},
}

return EggConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">EggPlacement</string>
          <string name="Source"><![CDATA[-- Shared geometry only. Server independently validates every placement.
local Placement = { MaxDistance = 30, Gap = 0.25 }

function Placement.GetFrame(place, point, size)
	local localPoint = place.CFrame:PointToObjectSpace(point)
	return place.CFrame * CFrame.new(localPoint.X, place.Size.Y / 2 + size.Y / 2, localPoint.Z)
end

function Placement.IsValid(plot, point, size, rootPosition)
	local place = plot:FindFirstChild("Place")
	local eggs = plot:FindFirstChild("PlacedEggs")
	if not place or not place:IsA("BasePart") or not eggs then return false end
	local p = place.CFrame:PointToObjectSpace(point)
	if math.abs(p.Y - place.Size.Y / 2) > 0.15 then return false end
	if math.abs(p.X) + size.X / 2 > place.Size.X / 2
		or math.abs(p.Z) + size.Z / 2 > place.Size.Z / 2 then return false end
	if (point - rootPosition).Magnitude > Placement.MaxDistance then return false end
	if #eggs:GetChildren() >= (plot:GetAttribute("SlotCapacity") or 6) then return false end
	for _, egg in ipairs(eggs:GetChildren()) do
		if egg:IsA("Model") then
			local frame, otherSize = egg:GetBoundingBox()
			local other = place.CFrame:PointToObjectSpace(frame.Position)
			if math.abs(p.X - other.X) < (size.X + otherSize.X) / 2 + Placement.Gap
				and math.abs(p.Z - other.Z) < (size.Z + otherSize.Z) / 2 + Placement.Gap then
				return false
			end
		end
	end
	return true
end

function Placement.Move(model, boundingFrame)
	local current = model:GetBoundingBox()
	model:PivotTo(boundingFrame * current:ToObjectSpace(model:GetPivot()))
end

return Placement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">EggRoller</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage.Modules.EggRoller
-- Faza 4

local ReplicatedStorage =
	game:GetService("ReplicatedStorage")

local modulesFolder =
	ReplicatedStorage:WaitForChild("Modules")

local eggConfigModule =
	modulesFolder:WaitForChild("EggConfig")

if not eggConfigModule:IsA("ModuleScript") then
	error(
		"[EggRoller] EggConfig mora biti ModuleScript."
	)
end

local EggConfig =
	require(eggConfigModule)

local rarityConfigModule =
	modulesFolder:WaitForChild("RarityConfig")

if not rarityConfigModule:IsA("ModuleScript") then
	error(
		"[EggRoller] RarityConfig mora biti ModuleScript."
	)
end

local RarityConfig =
	require(rarityConfigModule)

local sizeConfigModule =
	modulesFolder:WaitForChild("SizeConfig")

if not sizeConfigModule:IsA("ModuleScript") then
	error(
		"[EggRoller] SizeConfig mora biti ModuleScript."
	)
end

local SizeConfig =
	require(sizeConfigModule)

local EggRoller = {}

--------------------------------------------------
-- ROLL EGG FOR BIOME
--------------------------------------------------

function EggRoller.RollEggForBiome(
	biomeKey,
	randomObject
)
	if type(biomeKey) ~= "string"
		or biomeKey == "" then

		return nil,
			"Biome key nije validan string."
	end

	local pool =
		EggConfig.BiomePools[biomeKey]

	if not pool then
		return nil,
			string.format(
				"Biome pool '%s' ne postoji u EggConfig.",
				biomeKey
			)
	end

	if #pool == 0 then
		return nil,
			string.format(
				"Biome pool '%s' je prazan.",
				biomeKey
			)
	end

	--------------------------------------------------
	-- TOTAL WEIGHT
	--------------------------------------------------

	local totalWeight = 0

	for index, entry in ipairs(pool) do
		if type(entry.Weight) ~= "number"
			or entry.Weight <= 0 then

			return nil,
				string.format(
					"Biome '%s' entry #%d ima nevalidan Weight.",
					biomeKey,
					index
				)
		end

		totalWeight += entry.Weight
	end

	if totalWeight <= 0 then
		return nil,
			string.format(
				"Biome '%s' ima totalWeight <= 0.",
				biomeKey
			)
	end

	--------------------------------------------------
	-- RANDOM ROLL
	--------------------------------------------------

	local roll =
		randomObject:NextNumber(
			0,
			totalWeight
		)

	local runningWeight = 0
	local selectedEntry = nil

	for _, entry in ipairs(pool) do
		runningWeight += entry.Weight

		if roll <= runningWeight then
			selectedEntry = entry
			break
		end
	end

	-- floating point fallback
	if not selectedEntry then
		selectedEntry = pool[#pool]
	end

	--------------------------------------------------
	-- EGG TYPE
	--------------------------------------------------

	local eggType =
		selectedEntry.EggType

	if type(eggType) ~= "string"
		or eggType == "" then

		return nil,
			string.format(
				"Biome '%s' ima pool entry bez validnog EggType.",
				biomeKey
			)
	end

	local definition =
		EggConfig.EggTypes[eggType]

	if not definition then
		return nil,
			string.format(
				"EggType '%s' iz biome-a '%s' ne postoji u EggConfig.EggTypes.",
				eggType,
				biomeKey
			)
	end

	--------------------------------------------------
	-- VALIDATE DEFINITION
	--------------------------------------------------

	if definition.EggType ~= eggType then
		return nil,
			string.format(
				"Egg definition '%s' ima pogrešan EggType '%s'.",
				eggType,
				tostring(
					definition.EggType
				)
			)
	end

	if type(definition.EggName) ~= "string"
		or definition.EggName == "" then

		return nil,
			string.format(
				"EggType '%s' nema validan EggName.",
				eggType
			)
	end

	if type(definition.ModelName) ~= "string"
		or definition.ModelName == "" then

		return nil,
			string.format(
				"EggType '%s' nema validan ModelName.",
				eggType
			)
	end

	if not RarityConfig.IsValid(definition.Rarity) then

		return nil,
			string.format(
				"EggType '%s' ima nevalidan Rarity '%s'.",
				eggType,
				tostring(
					definition.Rarity
				)
			)
	end

	return definition, nil
end

--------------------------------------------------
-- ROLL SIZE
--------------------------------------------------

function EggRoller.RollSize(
	randomObject
)
	local sizes =
		EggConfig.Sizes

	if not sizes
		or #sizes == 0 then

		return nil,
			"EggConfig.Sizes je prazan."
	end

	local totalWeight = 0

	for index, sizeInfo in ipairs(
		sizes
	) do
		if type(sizeInfo.Weight) ~= "number"
			or sizeInfo.Weight <= 0 then

			return nil,
				string.format(
					"Size entry #%d ima nevalidan Weight.",
					index
				)
		end

		totalWeight += sizeInfo.Weight
	end

	if totalWeight <= 0 then
		return nil,
			"Size totalWeight je <= 0."
	end

	local roll =
		randomObject:NextNumber(
			0,
			totalWeight
		)

	local runningWeight = 0
	local selectedSize = nil

	for _, sizeInfo in ipairs(
		sizes
	) do
		runningWeight +=
			sizeInfo.Weight

		if roll <= runningWeight then
			selectedSize = sizeInfo
			break
		end
	end

	if not selectedSize then
		selectedSize =
			sizes[#sizes]
	end

	--------------------------------------------------
	-- VALIDATE SIZE
	--------------------------------------------------

	if type(selectedSize.Name) ~= "string"
		or selectedSize.Name == "" then

		return nil,
			"Odabrani size nema validan Name."
	end

	if not SizeConfig.IsValid(selectedSize.Name) then
		return nil,
			string.format(
				"Size '%s' ne postoji u SizeConfig.",
				tostring(selectedSize.Name)
			)
	end

	if type(selectedSize.Scale) ~= "number"
		or selectedSize.Scale <= 0 then

		return nil,
			string.format(
				"Size '%s' nema validan Scale.",
				tostring(
					selectedSize.Name
				)
			)
	end

	return selectedSize, nil
end

return EggRoller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GuardianConfig</string>
          <string name="Source"><![CDATA[--!strict

-- ReplicatedStorage.Modules.GuardianConfig
-- Faza 8. Guardian koristi Humanoid.WalkSpeed, nikada Player.Stats.Speed.

local GuardianConfig = {}

GuardianConfig.DefaultBiomeSpeed = 25
GuardianConfig.CatchDistance = 5
GuardianConfig.SafeZonePadding = 4
GuardianConfig.PathRecomputeSeconds = 0.35
GuardianConfig.ChaseTickSeconds = 0.05
GuardianConfig.WaypointReachDistance = 2
GuardianConfig.KnockbackSpeed = 95
GuardianConfig.KnockbackUpSpeed = 42
GuardianConfig.RagdollMinSeconds = 1
GuardianConfig.RagdollMaxSeconds = 5
GuardianConfig.RagdollGroundedSeconds = 0.4

local biomeBaseSpeed: { [string]: number } = {
	HatchlingFields = 25,
	Volcano = 45,
	Void = 70,
}
GuardianConfig.BiomeBaseSpeed = biomeBaseSpeed

-- Procentualni dodatak na biome baznu brzinu.
local raritySpeedBonus: { [string]: number } = {
	Common = 0,
	Uncommon = 0.025,
	Rare = 0.05,
	Epic = 0.10,
	Legendary = 0.20,
	Mythic = 0.30,
}
GuardianConfig.RaritySpeedBonus = raritySpeedBonus

function GuardianConfig.GetWalkSpeed(biomeName: unknown, rarityName: unknown): number
	local baseSpeed = if type(biomeName) == "string" then GuardianConfig.BiomeBaseSpeed[biomeName] else nil
	baseSpeed = if type(baseSpeed) == "number" then baseSpeed else GuardianConfig.DefaultBiomeSpeed
	local bonus = if type(rarityName) == "string" then GuardianConfig.RaritySpeedBonus[rarityName] else nil
	bonus = if type(bonus) == "number" then bonus else 0
	return baseSpeed * (1 + bonus)
end

return GuardianConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">HatchConfig</string>
          <string name="Source"><![CDATA[local Config = {}

Config.Timers = { Common = 3, Uncommon = 5, Rare = 8, Epic = 15, Legendary = 30, Mythic = 60 }
Config.Monsters = require(script.Parent:WaitForChild("MonsterConfig")).Definitions
Config.Pools = {
	hatchling_egg = {{"green_slime", 70}, {"leaf_bunny", 20}, {"baby_goblin", 8}, {"forest_dragon", 2}},
	forest_egg = {{"leaf_bunny", 60}, {"baby_goblin", 30}, {"forest_dragon", 10}},
	slime_egg = {{"green_slime", 100}},
	magma_egg = {{"magma_slime", 75}, {"flame_goblin", 25}},
	inferno_egg = {{"flame_goblin", 80}, {"inferno_dragon", 20}},
	dragon_egg = {{"inferno_dragon", 100}},
	basic_egg = {{"green_slime", 70}, {"leaf_bunny", 20}, {"baby_goblin", 8}, {"forest_dragon", 2}},
}

function Config.Roll(eggType, random)
	local pool = Config.Pools[eggType]
	if not pool or #pool == 0 then return nil end
	local total = 0
	for _, entry in ipairs(pool) do
		if not Config.Monsters[entry[1]] or type(entry[2]) ~= "number"
			or entry[2] ~= entry[2] or entry[2] <= 0 or entry[2] == math.huge then return nil end
		total += entry[2]
	end
	local choice = random:NextNumber() * total
	for _, entry in ipairs(pool) do
		choice -= entry[2]
		if choice < 0 then return entry[1] end
	end
	return pool[#pool][1]
end

return Config
]]></string>
        </Properties>
      </Item>
