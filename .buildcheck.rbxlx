status.TextSize = 18
status.Text = ""
status.TextColor3 = Color3.fromRGB(255, 255, 255)
status.Parent = statusContainer

local function formatSpeed(value)
	if value == math.floor(value) then
		return string.format("%.0f", value)
	end

	return string.format("%.2f", value)
end

local function updateProgress(playerSpeed, recommendedSpeed)
	local ratio = 0

	if recommendedSpeed &gt; 0 then
		ratio = math.clamp(playerSpeed / recommendedSpeed, 0, 1)
	end

	TweenService:Create(
		progressFill,
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(ratio, 0, 1, 0)
		}
	):Play()
end

local function showPanel()
	panel.Position = UDim2.new(0.5, 0, 0, 4)
	panel.BackgroundTransparency = 1
	panel.Visible = true

	TweenService:Create(
		panel,
		TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Position = UDim2.new(0.5, 0, 0, 18),
			BackgroundTransparency = 0.05
		}
	):Play()
end

event.OnClientEvent:Connect(function(data)
	if not data.Visible then
		panel.Visible = false
		return
	end

	biomeName.Text = string.upper(data.BiomeName)

	recommendedValue.Text =
		formatSpeed(data.RecommendedSpeed)

	currentValue.Text =
		formatSpeed(data.PlayerSpeed)

	status.Text = data.Status

	updateProgress(
		data.PlayerSpeed,
		data.RecommendedSpeed
	)

	if data.Status == "READY" then
		status.TextColor3 = Color3.fromRGB(110, 255, 165)
		statusContainer.BackgroundColor3 =
			Color3.fromRGB(24, 66, 49)

		currentValue.TextColor3 =
			Color3.fromRGB(110, 255, 165)
	else
		status.TextColor3 = Color3.fromRGB(255, 116, 116)
		statusContainer.BackgroundColor3 =
			Color3.fromRGB(72, 34, 39)

		currentValue.TextColor3 =
			Color3.fromRGB(255, 140, 140)
	end

	if not panel.Visible then
		showPanel()
	end
end)

event:FireServer("Ready")</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="42">
          <Properties>
            <string name="Name">CustomMovementAnimations</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local player = Players.LocalPlayer

local RUN_ANIMATION_ID = "rbxassetid://110696808533851"
local WALK_ANIMATION_ID = "rbxassetid://507777826"

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animate = character:WaitForChild("Animate")

	local run = animate:FindFirstChild("run")

	if not run then
		warn("Run animation nije pronađena")
		return
	end

	local runAnim = run:FindFirstChild("RunAnim")

	if not runAnim then
		warn("RunAnim nije pronađen")
		return
	end

	runAnim.AnimationId = player:GetAttribute("SlowMode") and WALK_ANIMATION_ID or RUN_ANIMATION_ID
end

if player.Character then
	setupCharacter(player.Character)
end

player.CharacterAdded:Connect(setupCharacter)

player:GetAttributeChangedSignal("SlowMode"):Connect(function()
	if player.Character then
		setupCharacter(player.Character)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">EggPlacement</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Placement = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("EggPlacement"))
local remote = ReplicatedStorage:WaitForChild("PlaceEggEvent", 10)
if not remote or not remote:IsA("RemoteEvent") then
	warn("[EggPlacement] PlaceEggEvent missing. Stop Play, sync Rojo including default.project.json, then start a new session.")
	return
end
task.delay(10, function()
	if not remote:GetAttribute("ServerReady") then
		warn("[EggPlacement] Server is not ready. Check ServerScriptService.Server.EggPlacementSystem and earlier server Output errors.")
	end
end)
local ghost, equipped, size, point
local valid = false
local lastColor
local gray = Color3.fromRGB(175, 175, 175)
local red = Color3.fromRGB(235, 65, 65)

local function clear()
	if ghost then ghost:Destroy() end
	ghost, equipped, size, point, lastColor = nil, nil, nil, nil, nil
	valid = false
end

local function makePreview(tool)
	clear()
	local visual = tool:FindFirstChild("EggVisual")
	if not visual then return end
	ghost = visual:Clone()
	ghost.Name = "LocalEggPlacementPreview"
	for _, object in ipairs(ghost:GetDescendants()) do
		if object:IsA("JointInstance") or object:IsA("Constraint") or object:IsA("LuaSourceContainer")
			or object:IsA("SurfaceAppearance") or object:IsA("Decal") or object:IsA("Texture")
			or object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
			or object:IsA("Light") or object:IsA("BillboardGui") or object:IsA("SurfaceGui")
			or object:IsA("Highlight") then
			object:Destroy()
		elseif object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
			object.Transparency = if object.Transparency >= 1 then 1 else 0.6
			object.Material = Enum.Material.SmoothPlastic
			object.Reflectance = 0
			object.CastShadow = false
			if object:IsA("UnionOperation") then object.UsePartColor = true end
			if object:IsA("MeshPart") then object.TextureID = "" end
		elseif object:IsA("SpecialMesh") then
			object.TextureId = ""
			object.VertexColor = Vector3.new(1, 1, 1)
		end
	end
	ghost:PivotTo(CFrame.new())
	local _, bounds = ghost:GetBoundingBox()
	size = bounds
	equipped = tool
	ghost.Parent = workspace
end

local function updatePreview()
	valid = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool or not tool:GetAttribute("IsEggTool") or not root or not humanoid or humanoid.Health <= 0 then
		if ghost then clear() end
		return
	end
	if equipped ~= tool then makePreview(tool) end
	if not ghost then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	-- Roblox supplies the cursor ray in the correct screen coordinate space.
	-- Do not subtract GUI inset from viewport coordinates manually.
	local ray = mouse.UnitRay
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character, ghost}
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	point = if hit then hit.Position else ray.Origin + ray.Direction * 30
	local plots = workspace:FindFirstChild("Plots")
	local name = player:GetAttribute("PlotName")
	local plot = plots and type(name) == "string" and plots:FindFirstChild(name)
	local place = plot and plot:FindFirstChild("Place")
	valid = remote:GetAttribute("ServerReady") == true and hit ~= nil and place ~= nil and hit.Instance == place
		and plot:GetAttribute("OwnerUserId") == player.UserId
		and Placement.IsValid(plot, point, size, root.Position)
	local frame = if place and hit and hit.Instance == place
		then Placement.GetFrame(place, point, size)
		else CFrame.new(point + Vector3.new(0, size.Y / 2, 0))
	Placement.Move(ghost, frame)
	local color = if valid then gray else red
	if color ~= lastColor then
		for _, object in ipairs(ghost:GetDescendants()) do
			if object:IsA("BasePart") then object.Color = color end
		end
		lastColor = color
	end
end

RunService:BindToRenderStep("EggPlacementPreview", Enum.RenderPriority.Camera.Value + 1, updatePreview)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	-- Recompute at click time rather than sending the previous rendered frame's point.
	updatePreview()
	if valid and equipped and equipped.Parent == player.Character and point then
		remote:FireServer(equipped:GetAttribute("UID"), point)
	end
end)

player.CharacterRemoving:Connect(clear)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="44">
          <Properties>
            <string name="Name">GuardianRagdoll</string>
            <string name="Source"><![CDATA[-- Match the local Humanoid/animation controller to the server's hit state.
-- The client never decides who gets hit or the launch velocity.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local connection, stepConnection
	local saved = nil
	local function restore()
		if stepConnection then stepConnection:Disconnect(); stepConnection = nil end
		if not saved then return end
		for motor, enabled in pairs(saved.motors) do
			if motor.Parent then motor.Enabled = enabled end
		end
		if saved.animate and saved.animate.Parent then saved.animate.Enabled = saved.animateEnabled end
		if humanoid.Parent then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, saved.gettingUp)
			humanoid.PlatformStand = false
			if humanoid.Health > 0 then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
		end
		saved = nil
	end
	local function update()
		if character:GetAttribute("GuardianRagdoll") ~= true then restore(); return end
		if saved then return end
		local animate = character:FindFirstChild("Animate")
		saved = { motors = {}, gettingUp = humanoid:GetStateEnabled(Enum.HumanoidStateType.GettingUp), animate = nil }
		if animate and animate:IsA("LocalScript") then
			saved.animate, saved.animateEnabled = animate, animate.Enabled
			animate.Enabled = false
		end
		-- Server tags only originally enabled body motors belonging to this hit.
		local function enforce()
			for _, joint in ipairs(character:GetDescendants()) do
				if (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint"))
					and joint:GetAttribute("GuardianRagdollMotor") == true then
					saved.motors[joint] = true
					joint.Enabled = false
				end
			end
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
			end
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			humanoid.PlatformStand = true
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end
		enforce()
		stepConnection = RunService.PreSimulation:Connect(enforce)
	end
	connection = character:GetAttributeChangedSignal("GuardianRagdoll"):Connect(update)
	local removing
	removing = player.CharacterRemoving:Connect(function(oldCharacter)
		if oldCharacter ~= character then return end
		connection:Disconnect()
		restore()
		removing:Disconnect()
	end)
	update()
end

player.CharacterAdded:Connect(setup)
if player.Character then task.spawn(setup, player.Character) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="45">
          <Properties>
            <string name="Name">IndexUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("MonsterConfig"))
local unlocks = player:WaitForChild("IndexUnlocks")
local previews = ReplicatedStorage:WaitForChild("IndexPreviews")
local playerGui = player:WaitForChild("PlayerGui")
local biomeNames = { "Hatchling Fields", "Bio Marsh", "Spore Lab", "Volcano", "Cryo Sector", "Fossil Lab", "Mutation Core", "Cosmic Incubator" }
local sectionBiomes = { "HatchlingFields", "BioMarsh", "SporeLab", "Volcano", "CryoSector", "FossilLab", "MutationCore", "CosmicIncubator" }
local rarityOrder = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6 }
local catalog = {}
for id, definition in pairs(Config.Definitions) do table.insert(catalog, { id = id, definition = definition }) end
table.sort(catalog, function(a, b)
	local ra, rb = rarityOrder[a.definition.Rarity], rarityOrder[b.definition.Rarity]
	if ra ~= rb then return ra < rb end
	return a.definition.IndexId < b.definition.IndexId
end)
local currentGui, refresh
local connections = {}

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
end

local function viewport(holder, id, unlocked)
	local old = holder:FindFirstChild("IndexViewport")
	if old then old:Destroy() end
	local question = holder:FindFirstChild("QuestionMark")
	if question then question.Visible = not unlocked end
	local image = holder:FindFirstChild("MonsterImage")
	if image then image.Visible = false end
	if not unlocked then return end
	local source = previews:FindFirstChild(id)
	if not source then return end
	local view = Instance.new("ViewportFrame")
	view.Name = "IndexViewport"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	view.ZIndex = holder.ZIndex + 1
	view.Ambient = Color3.fromRGB(200, 200, 200)
	view.LightColor = Color3.new(1, 1, 1)
	local world = Instance.new("WorldModel")
	world.Parent = view
	local model = source:Clone()
	model.Parent = world
	local frame, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	local distance = size.Magnitude / (2 * math.tan(math.rad(camera.FieldOfView / 2))) * 1.15
	camera.CFrame = CFrame.lookAt(frame.Position + Vector3.new(0.25, 0.15, -1).Unit * distance, frame.Position)
	camera.Parent = view
	view.CurrentCamera = camera
	view.Parent = holder
end

local function bind(gui)
	if currentGui == gui then return end
	for _, connection in ipairs(connections) do connection:Disconnect() end
	connections = {}
	currentGui, refresh = gui, nil
	local frame = gui:WaitForChild("Frame", 10)
	local bottom = frame and frame:WaitForChild("BottomFrame", 10)
	local details = bottom and bottom:FindFirstChild("MonsterDetails")
	local scroller = bottom and bottom:FindFirstChild("BiomeScroller")
	if not details or not scroller then warn("[IndexUI] Missing MonsterDetails/BiomeScroller"); return end
	-- Reuse the user's styles and reserve separate rows for the two new fields.
	for _, name in ipairs({"BaseIncome", "BestSizeFound"}) do
		if not details:FindFirstChild(name) then
			local label = details.Biome:Clone()
			label.Name = name
			label.Parent = details
		end
	end
	local rows = { MonsterName = 0.44, Rarity = 0.54, Biome = 0.62, BaseIncome = 0.70, BestSizeFound = 0.78, Status = 0.88 }
	details.ImageHolder.Position = UDim2.fromScale(0.1, 0.03)
	details.ImageHolder.Size = UDim2.fromScale(0.8, 0.39)
	details.ImageHolder.AnchorPoint = Vector2.zero
	for name, y in pairs(rows) do
		local label = details:FindFirstChild(name)
		if label then
			label.AnchorPoint = Vector2.zero
			label.Position = UDim2.fromScale(0.05, y)
			label.Size = UDim2.fromScale(0.9, if name == "MonsterName" then 0.09 else 0.07)
			label.TextScaled = true
			label.TextWrapped = true
		end
	end
	local selected
	local bindings = {}
	local sections = {}
	for index, biome in ipairs(sectionBiomes) do
		local section = scroller:FindFirstChild("BiomeSection_" .. index)
		if not section then continue end
		local entries = {}
		for _, entry in ipairs(catalog) do if entry.definition.Biome == biome then table.insert(entries, entry) end end
		section.BiomePreview.BiomeName.Text = biomeNames[index]
		section.Visible = #entries > 0
		table.insert(sections, { section = section, entries = entries })
		local area = section.CreatureArea
		local template = area:FindFirstChild("CreatureSlot_1")
		for _, slot in ipairs(area:GetChildren()) do
			if slot:IsA("GuiObject") and slot.Name:match("^CreatureSlot_") then slot.Visible = false end
		end
		for slotIndex, entry in ipairs(entries) do
			local slot = area:FindFirstChild("CreatureSlot_" .. slotIndex)
			if not slot and template then slot = template:Clone(); slot.Name = "CreatureSlot_" .. slotIndex; slot.Parent = area end
			if not slot then continue end
			slot.Visible, slot.LayoutOrder = true, slotIndex
			local button = slot:FindFirstChild("IndexSelect") or Instance.new("TextButton")
			button.Name = "IndexSelect"
			button.Size = UDim2.fromScale(1, 1)
			button.BackgroundTransparency = 1
			button.Text = ""
			button.ZIndex = slot.ImageArea.ZIndex + 5
			button.Parent = slot
			connect(button.Activated, function() selected = entry; if refresh then refresh() end end)
			table.insert(bindings, { slot = slot, entry = entry })
		end
	end
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	refresh = function()
		if currentGui ~= gui or not gui.Parent then return end
		local count = 0
		for _, entry in ipairs(catalog) do if unlocks:FindFirstChild(entry.definition.IndexId) then count += 1 end end
		bottom.UnlockedBar.UnlockedText.Text = string.format("Unlocked: %d/%d", count, #catalog)
		local status = player:GetAttribute("IndexDataStatus")
		if status == "LoadFailed" then bottom.UnlockedBar.UnlockedText.Text ..= " (session only)"
		elseif status == "SaveFailed" then bottom.UnlockedBar.UnlockedText.Text ..= " (save pending)" end
		for _, info in ipairs(sections) do
			local found = 0
			for _, entry in ipairs(info.entries) do if unlocks:FindFirstChild(entry.definition.IndexId) then found += 1 end end
			info.section.BiomePreview.Progress.Text = string.format("%d/%d", found, #info.entries)
		end
		for _, info in ipairs(bindings) do
			local def = info.entry.definition
			local unlocked = unlocks:FindFirstChild(def.IndexId) ~= nil
			info.slot.CreatureName.Text = if unlocked then def.MonsterName else "???"
			viewport(info.slot.ImageArea, def.IndexId, unlocked)
		end
		local def = selected and selected.definition
		local record = def and unlocks:FindFirstChild(def.IndexId)
		details.MonsterName.Text = if record then def.MonsterName elseif def then "???" else "Select a Creature"
		details.Rarity.Text = if record then def.Rarity else "???"
		details.Biome.Text = "Biome: " .. (if record then (if def.Biome == "HatchlingFields" then "Hatchling Fields" else def.Biome) else "???")
		details.BaseIncome.Text = if record then string.format("Base Income: $%g/sec", def.BaseIncome) else "Base Income: ???"
		details.BestSizeFound.Text = "Best Size Found: " .. (if record then record:GetAttribute("BestSizeFound") or "???" else "???")
		details.Status.Text = if record then "UNLOCKED" elseif def then "LOCKED" else "SELECT A CREATURE"
		viewport(details.ImageHolder, if def then def.IndexId else "", record ~= nil)
	end
	connect(frame.TopFrame.ExitButton.Activated, function() frame.Visible = false end)
	refresh()
end

local function changed() if refresh then refresh() end end
player:GetAttributeChangedSignal("IndexDataStatus"):Connect(changed)
local recordConnections = {}
local function watch(record)
	recordConnections[record] = record:GetAttributeChangedSignal("BestSizeFound"):Connect(changed)
	changed()
end
unlocks.ChildAdded:Connect(watch)
unlocks.ChildRemoved:Connect(function(record)
	if recordConnections[record] then recordConnections[record]:Disconnect(); recordConnections[record] = nil end
	changed()
end)
for _, record in ipairs(unlocks:GetChildren()) do watch(record) end
playerGui.ChildAdded:Connect(function(gui) if gui.Name == "IndexUi" then task.spawn(bind, gui) end end)
playerGui.ChildRemoved:Connect(function(gui)
	if gui == currentGui then
		for _, connection in ipairs(connections) do connection:Disconnect() end
		connections, currentGui, refresh = {}, nil, nil
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.I then return end
	local gui = currentGui
	local frame = gui and gui:FindFirstChild("Frame")
	if frame then gui.Enabled = true; frame.Visible = not frame.Visible end
end)
local existing = playerGui:FindFirstChild("IndexUi")
if existing then task.spawn(bind, existing) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="46">
          <Properties>
            <string name="Name">LavaAnimation (Thermal Chamber)</string>
            <string name="Source">local RunService = game:GetService("RunService")

local lavaFloor = workspace:WaitForChild("LavaFloor")
local texture = lavaFloor:WaitForChild("Texture")
local light = lavaFloor:WaitForChild("SurfaceLight")

-- =========================
-- POMERANJE LAVE
-- =========================

local MOVE_SPEED_U = 0.6
local MOVE_SPEED_V = 0.18

-- =========================
-- PULSIRANJE SVETLA
-- =========================

local BASE_BRIGHTNESS = 0.8
local BRIGHTNESS_PULSE = 0.35

-- =========================
-- PULSIRANJE TEKSTURE
-- =========================

local BASE_TRANSPARENCY = 0.02
local TRANSPARENCY_PULSE = 0.08

-- Brzina pulsiranja
local PULSE_SPEED_1 = 1.3
local PULSE_SPEED_2 = 2.1

-- =========================
-- START VREDNOSTI
-- =========================

local timePassed = 0
local offsetU = texture.OffsetStudsU
local offsetV = texture.OffsetStudsV

-- =========================
-- ANIMACIJA
-- =========================

RunService.RenderStepped:Connect(function(dt)
	timePassed += dt

	-- Pomeranje lava teksture
	offsetU += MOVE_SPEED_U * dt
	offsetV += MOVE_SPEED_V * dt

	texture.OffsetStudsU = offsetU
	texture.OffsetStudsV = offsetV

	-- Nepravilan heat pulse
	local wave1 = math.sin(timePassed * PULSE_SPEED_1)
	local wave2 = math.sin(timePassed * PULSE_SPEED_2)

	local pulse = wave1 * 0.7 + wave2 * 0.3

	-- Pretvaramo otprilike u 0 - 1e
	pulse = (pulse + 1) / 2

	-- Pulsiranje SurfaceLight-a
	light.Brightness =
		BASE_BRIGHTNESS + pulse * BRIGHTNESS_PULSE

	-- Pulsiranje same teksture
	-- Kad je pulse jači, lava je manje providna
	texture.Transparency =
		BASE_TRANSPARENCY + (1 - pulse) * TRANSPARENCY_PULSE
end)</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="47">
          <Properties>
            <string name="Name">TreadmillAnimation</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character, humanoid, animator, track, animation, diedConnection
local generation = 0

local function stop()
	if track then
		track:Stop(0.15)
		track:Destroy()
		track = nil
	end
	if animation then animation:Destroy(); animation = nil end
end

local function update()
	if not player:GetAttribute("TreadmillLocked") or not humanoid or humanoid.Health <= 0
		or character ~= player.Character or not animator then
		stop()
		return
	end
	if track then return end
	-- Match the existing movement animation instead of relying on Running speed:
	-- the treadmill holds the root still, so the normal Animate script sees zero speed.
	local animate = character:FindFirstChild("Animate")
	local run = animate and animate:FindFirstChild("run")
	local source = run and run:FindFirstChildWhichIsA("Animation", true)
	local id = source and source.AnimationId
	if not id or id == "" then
		id = if humanoid.RigType == Enum.HumanoidRigType.R6
			then "rbxassetid://180426354" else "rbxassetid://110696808533851"
	end
	animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, result = pcall(function() return animator:LoadAnimation(animation) end)
	if not ok then
		warn("[TreadmillAnimation] " .. tostring(result))
		stop()
		return
	end
	track = result
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.15, 1, 1)
end

local function setup(nextCharacter)
	generation += 1
	local current = generation
	stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	character, humanoid, animator = nextCharacter, nil, nil
	local nextHumanoid = nextCharacter:WaitForChild("Humanoid", 10)
	local nextAnimator = nextHumanoid and nextHumanoid:WaitForChild("Animator", 10)
	if current ~= generation or player.Character ~= nextCharacter then return end
	if not nextHumanoid or not nextAnimator then return end
	humanoid, animator = nextHumanoid, nextAnimator
	diedConnection = humanoid.Died:Connect(stop)
	update()
end

player:GetAttributeChangedSignal("TreadmillLocked"):Connect(update)
player.CharacterAdded:Connect(setup)
player.CharacterRemoving:Connect(function()
	generation += 1
	stop()
	if diedConnection then diedConnection:Disconnect(); diedConnection = nil end
	character, humanoid, animator = nil, nil, nil
end)
if player.Character then task.spawn(setup, player.Character) end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="48">
          <Properties>
            <string name="Name">TreadmillControls</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("TreadmillJumpEvent", 15)
if not event then warn("[Treadmill] Server did not initialize TreadmillJumpEvent"); return end
local lastJump = 0
UserInputService.JumpRequest:Connect(function()
	if not player:GetAttribute("TreadmillLocked") then return end
	local now = os.clock()
	if now - lastJump < 0.2 then return end
	lastJump = now
	event:FireServer()
end)
event.OnClientEvent:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Jump = true
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)
]]></string>
