	{ Capacity = 16, Cost = 250000000000 },
}

function Config.GetLevel(capacity)
	for level, definition in ipairs(Config.Levels) do
		if definition.Capacity == capacity then return level, definition end
	end
	return nil
end

return Config
]]></string>
