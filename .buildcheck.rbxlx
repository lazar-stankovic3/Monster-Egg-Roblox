      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MonsterConfig</string>
          <string name="Source"><![CDATA[local RarityConfig = require(script.Parent:WaitForChild("RarityConfig"))
local SizeConfig = require(script.Parent:WaitForChild("SizeConfig"))
local Config = {}

-- Initial base rates. Rarity is the species default; hatched instances inherit egg rarity.
local function definition(name, biome, rarity, income, modelName, indexId, color)
	return { MonsterName = name, Biome = biome, Rarity = rarity, BaseIncome = income,
		ModelName = modelName, IndexId = indexId, Icon = "", Color = color }
end

Config.Definitions = {
	green_slime = definition("Green Slime", "HatchlingFields", "Common", 2, "GreenSlime", "green_slime", Color3.fromRGB(80, 210, 100)),
	leaf_bunny = definition("Leaf Bunny", "HatchlingFields", "Uncommon", 4, "LeafBunny", "leaf_bunny", Color3.fromRGB(170, 225, 100)),
	baby_goblin = definition("Baby Goblin", "HatchlingFields", "Rare", 8, "BabyGoblin", "baby_goblin", Color3.fromRGB(90, 150, 65)),
	forest_dragon = definition("Forest Dragon", "HatchlingFields", "Legendary", 20, "ForestDragon", "forest_dragon", Color3.fromRGB(35, 125, 75)),
	magma_slime = definition("Magma Slime", "Volcano", "Rare", 12, "MagmaSlime", "magma_slime", Color3.fromRGB(255, 115, 35)),
	flame_goblin = definition("Flame Goblin", "Volcano", "Epic", 25, "FlameGoblin", "flame_goblin", Color3.fromRGB(210, 65, 40)),
	inferno_dragon = definition("Inferno Dragon", "Volcano", "Legendary", 60, "InfernoDragon", "inferno_dragon", Color3.fromRGB(150, 35, 35)),
}

function Config.CalculateIncome(monsterId, rarity, size)
	local entry = Config.Definitions[monsterId]
	local rarityMultiplier = RarityConfig.GetIncomeMultiplier(rarity)
	local sizeMultiplier = SizeConfig.GetIncomeMultiplier(size)
	if not entry or not rarityMultiplier or not sizeMultiplier then return nil end
	local base = entry.BaseIncome
	if type(base) ~= "number" or base ~= base or base < 0 or base == math.huge then return nil end
	return base * rarityMultiplier * sizeMultiplier
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RarityConfig</string>
          <string name="Source"><![CDATA[--!strict

-- ReplicatedStorage.Modules.RarityConfig
-- Faza 5
--
-- Jedini izvor istine za stabilna rarity imena i njihove income multipliere.
-- Mnozilac se jos ne primenjuje na Cash: to radi Monster/Income sistem u fazama 13 i 14.

export type RarityName =
	"Common"
	| "Uncommon"
	| "Rare"
	| "Epic"
	| "Legendary"
	| "Mythic"

export type Definition = {
	Name: RarityName,
	IncomeMultiplier: number,
}

local RarityConfig = {}

local definitions: { [string]: Definition } = {
	Common = {
		Name = "Common",
		IncomeMultiplier = 1,
	},
	Uncommon = {
		Name = "Uncommon",
		IncomeMultiplier = 1.5,
	},
	Rare = {
		Name = "Rare",
		IncomeMultiplier = 2.5,
	},
	Epic = {
		Name = "Epic",
		IncomeMultiplier = 5,
	},
	Legendary = {
		Name = "Legendary",
		IncomeMultiplier = 10,
	},
	Mythic = {
		Name = "Mythic",
		IncomeMultiplier = 25,
	},
}

RarityConfig.Definitions = definitions

function RarityConfig.IsValid(rarityName: unknown): boolean
	return type(rarityName) == "string"
		and definitions[rarityName] ~= nil
end

function RarityConfig.GetDefinition(
	rarityName: unknown
): Definition?
	if type(rarityName) ~= "string" then
		return nil
	end

	return definitions[rarityName]
end

function RarityConfig.GetIncomeMultiplier(
	rarityName: unknown
): number?
	local definition = RarityConfig.GetDefinition(rarityName)

	if not definition then
		return nil
	end

	return definition.IncomeMultiplier
end

return RarityConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">SizeConfig</string>
          <string name="Source"><![CDATA[--!strict

-- ReplicatedStorage.Modules.SizeConfig
-- Faza 6
--
-- Jedini izvor istine za income multipliere velicine.
-- Vizuelni Scale i spawn Weight ostaju u EggConfig.Sizes, jer su deo postojeceg egg spawn balansa.

export type SizeName =
	"Tiny"
	| "Normal"
	| "Large"
	| "Huge"
	| "Titanic"

export type Definition = {
	Name: SizeName,
	IncomeMultiplier: number,
	CarryMovementPenalty: number,
}

local SizeConfig = {}

local definitions: { [string]: Definition } = {
	Tiny = { Name = "Tiny", IncomeMultiplier = 0.7, CarryMovementPenalty = 0 },
	Normal = { Name = "Normal", IncomeMultiplier = 1, CarryMovementPenalty = 0 },
	Large = { Name = "Large", IncomeMultiplier = 1.5, CarryMovementPenalty = 0.05 },
	Huge = { Name = "Huge", IncomeMultiplier = 2.5, CarryMovementPenalty = 0.1 },
	Titanic = { Name = "Titanic", IncomeMultiplier = 5, CarryMovementPenalty = 0.2 },
}

SizeConfig.Definitions = definitions

function SizeConfig.IsValid(sizeName: unknown): boolean
	return type(sizeName) == "string"
		and definitions[sizeName] ~= nil
end

function SizeConfig.GetDefinition(sizeName: unknown): Definition?
	if type(sizeName) ~= "string" then
		return nil
	end

	return definitions[sizeName]
end

function SizeConfig.GetIncomeMultiplier(sizeName: unknown): number?
	local definition = SizeConfig.GetDefinition(sizeName)

	if not definition then
		return nil
	end

	return definition.IncomeMultiplier
end

function SizeConfig.GetCarryMovementPenalty(sizeName: unknown): number?
	local definition = SizeConfig.GetDefinition(sizeName)

	if not definition then
		return nil
	end

	return definition.CarryMovementPenalty
end

return SizeConfig
]]></string>
        </Properties>
      </Item>
