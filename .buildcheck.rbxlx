      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MonsterService</string>
          <string name="Source">local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Modules:WaitForChild("MonsterConfig"))
local PlotService = require(script.Parent:WaitForChild("PlotService"))
local Service = {}

local function placeholder(definition)
	local model = Instance.new("Model")
	local function part(name, size, position, color, shape)
		local item = Instance.new("Part")
		item.Name, item.Size, item.Position, item.Color = name, size, position, color
		item.Shape = shape or Enum.PartType.Ball
		item.Anchored, item.CanCollide = true, false
		item.Material = Enum.Material.SmoothPlastic
		item.Parent = model
		return item
	end
	model.PrimaryPart = part("Body", Vector3.new(2, 1.8, 2), Vector3.new(0, 1, 0), definition.Color)
	for _, x in ipairs({-0.4, 0.4}) do
		part("Eye", Vector3.new(0.35, 0.45, 0.2), Vector3.new(x, 1.25, -0.9), Color3.new(1, 1, 1))
		part("Pupil", Vector3.new(0.14, 0.22, 0.12), Vector3.new(x, 1.25, -1.01), Color3.new(0, 0, 0))
	end
	if string.find(definition.MonsterName, "Bunny") then
		for _, x in ipairs({-0.45, 0.45}) do
			part("Ear", Vector3.new(0.4, 1.5, 0.5), Vector3.new(x, 2.2, 0), definition.Color)
		end
	elseif string.find(definition.MonsterName, "Dragon") then
		for _, x in ipairs({-1.1, 1.1}) do
			part("Wing", Vector3.new(0.6, 1.2, 1.3), Vector3.new(x, 1.2, 0.2), definition.Color, Enum.PartType.Block)
		end
	end
	model:SetAttribute("Placeholder", true)
	return model
end

function Service.Create(egg, monsterId)
	local definition = Config.Definitions[monsterId]
	local folder = ServerStorage:FindFirstChild("MonsterModels")
	local source = folder and folder:FindFirstChild(definition.ModelName)
	local model = source and source:IsA("Model") and source:Clone() or placeholder(definition)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("LuaSourceContainer") or item:IsA("JointInstance") or item:IsA("Constraint")
			or item:IsA("BodyMover") or item:IsA("ProximityPrompt") then item:Destroy() end
	end
	local firstPart
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			firstPart = firstPart or item
			item.Anchored = true
			item.CanCollide, item.CanTouch, item.CanQuery = false, false, true
			item.AssemblyLinearVelocity, item.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		end
	end
	if not firstPart then model:Destroy(); error("Monster model has no BasePart: " .. definition.ModelName) end
	model.PrimaryPart = model.PrimaryPart or firstPart
	model:ScaleTo(egg:GetAttribute("Scale"))
	model:PivotTo(CFrame.new())
	-- Inherit the egg's size multiplier exactly; never shrink to its footprint.
	model.Name = HttpService:GenerateGUID(false)
	for _, name in ipairs({"EggType", "EggName", "Biome", "Rarity", "Size", "Scale", "OwnerUserId"}) do
		model:SetAttribute(name, egg:GetAttribute(name))
	end
	model:SetAttribute("UID", model.Name)
	model:SetAttribute("SourceEggUID", egg:GetAttribute("UID"))
	model:SetAttribute("MonsterId", monsterId)
	model:SetAttribute("MonsterName", definition.MonsterName)
	model:SetAttribute("IsMonster", true)
	model:SetAttribute("VisualScale", model:GetScale())
	model:SetAttribute("BaseIncome", definition.BaseIncome)
	model:SetAttribute("BaseRarity", definition.Rarity)
	model:SetAttribute("IndexId", definition.IndexId)
	model:SetAttribute("Icon", definition.Icon)
	model:SetAttribute("ModelName", definition.ModelName)
	model:SetAttribute("MonsterBiome", definition.Biome)
	local income = Config.CalculateIncome(monsterId, egg:GetAttribute("Rarity"), egg:GetAttribute("Size"))
	if not income then model:Destroy(); error("Invalid monster income metadata") end
	model:SetAttribute("FinalIncome", income)
	return model
end

-- Calculate from server configuration, not the displayed FinalIncome attribute.
function Service.GetIncome(player)
	local plot = PlotService.GetPlot(player)
	if not plot or not PlotService.IsOwner(player, plot) then return 0 end
	local folder = plot:FindFirstChild("PlacedEggs")
	if not folder then return 0 end
	local total = 0
	local seen = {}
	for _, model in ipairs(folder:GetChildren()) do
		local uid = model:GetAttribute("UID")
		if model:IsA("Model") and model:GetAttribute("IsMonster") == true
			and model:GetAttribute("OwnerUserId") == player.UserId
			and type(uid) == "string" and uid ~= "" and not seen[uid] then
			seen[uid] = true
			total += Config.CalculateIncome(model:GetAttribute("MonsterId"), model:GetAttribute("Rarity"), model:GetAttribute("Size")) or 0
		end
	end
	return total
end

return Service</string>
        </Properties>
      </Item>
      <Item class="Script" referent="31">
        <Properties>
          <string name="Name">PlayerStats</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BASE_WALK_SPEED = 16
local SLOW_MODE_WALK_SPEED = 8

local slowModeEvent = ReplicatedStorage:FindFirstChild("SetSlowMode")
if not slowModeEvent then
	slowModeEvent = Instance.new("RemoteEvent")
	slowModeEvent.Name = "SetSlowMode"
	slowModeEvent.Parent = ReplicatedStorage
end

-- Pretvara Speed stat u stvarni Roblox WalkSpeed
local function calculateWalkSpeed(speedStat)
	return BASE_WALK_SPEED + 12 * math.log10((speedStat / 10) + 1)
end

local function getCarryMovementPenalty(player)
	local penalty = player:GetAttribute("CarryMovementPenalty")

	if typeof(penalty) ~= "number" then
		return 0
	end

	return math.clamp(penalty, 0, 0.95)
end

local function updatePlayerSpeed(player)
	local stats = player:FindFirstChild("Stats")
	if not stats then
		return
	end

	local speed = stats:FindFirstChild("Speed")
	if not speed then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if player:GetAttribute("SlowMode") then
		humanoid.WalkSpeed = SLOW_MODE_WALK_SPEED
	else
		humanoid.WalkSpeed = calculateWalkSpeed(speed.Value)
			* (1 - getCarryMovementPenalty(player))
	end
end

local function setupPlayer(player)
	player:SetAttribute("SlowMode", false)

	if player:GetAttribute("CarryMovementPenalty") == nil then
		player:SetAttribute("CarryMovementPenalty", 0)
	end

	-------------------------------
	-- STATS
	-------------------------------

	local stats = Instance.new("Folder")
	stats.Name = "Stats"
	stats.Parent = player

	local speed = Instance.new("NumberValue")
	speed.Name = "Speed"
	speed.Value = 0
	speed.Parent = stats

	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Value = 1000
	cash.Parent = stats

	-------------------------------
	-- LEADERSTATS
	-------------------------------

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local displaySpeed = Instance.new("NumberValue")
	displaySpeed.Name = "Speed"
	displaySpeed.Value = speed.Value
	displaySpeed.Parent = leaderstats

	local displayCash = Instance.new("NumberValue")
	displayCash.Name = "Cash"
	displayCash.Value = cash.Value
	displayCash.Parent = leaderstats

	-------------------------------
	-- SYNC
	-------------------------------

	speed.Changed:Connect(function()
		displaySpeed.Value = math.floor(speed.Value)

		updatePlayerSpeed(player)
	end)

	player:GetAttributeChangedSignal("SlowMode"):Connect(function()
		updatePlayerSpeed(player)
	end)

	player:GetAttributeChangedSignal("CarryMovementPenalty"):Connect(function()
		updatePlayerSpeed(player)
	end)

	cash.Changed:Connect(function()
		displayCash.Value = math.floor(cash.Value)
	end)

	-------------------------------
	-- CHARACTER
	-------------------------------

	local function characterAdded(character)
		local humanoid = character:WaitForChild("Humanoid")

		task.wait()

		updatePlayerSpeed(player)
	end

	player.CharacterAdded:Connect(characterAdded)

	if player.Character then
		characterAdded(player.Character)
	end
end

slowModeEvent.OnServerEvent:Connect(function(player, enabled)
	if typeof(enabled) == "boolean" then
		player:SetAttribute("SlowMode", enabled)
	end
end)

Players.PlayerAdded:Connect(setupPlayer)

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local PlotService = {}
local STARTING_SLOTS = 6
local started = false
local plots = {}
local assignments = {}
local waiting = {}
local queued = {}

local function resetPlot(plot, ownerUserId)
	plot:SetAttribute("OwnerUserId", ownerUserId)
	plot:SetAttribute("SlotCapacity", STARTING_SLOTS)
	plot.PlacedEggs:ClearAllChildren()
end

local function preparePlot(plot)
	if not plot:IsA("Model") then return false end
	local place = plot:FindFirstChild("Place")
	if not place or not place:IsA("BasePart") or not place.Anchored then
		warn("[PlotService] " .. plot:GetFullName() .. " needs an anchored Place Part.")
		return false
	end
	local eggs = plot:FindFirstChild("PlacedEggs")
	if eggs and not eggs:IsA("Folder") then
		warn("[PlotService] PlacedEggs must be a Folder: " .. plot:GetFullName())
		return false
	end
	if not eggs then
		eggs = Instance.new("Folder")
		eggs.Name = "PlacedEggs"
		eggs.Parent = plot
	end
	resetPlot(plot, 0)
	return true
end

local function assignWaiting()
	for _, plot in ipairs(plots) do
		if plot:GetAttribute("OwnerUserId") ~= 0 then
			continue
		end
		while #waiting > 0 do
			local player = table.remove(waiting, 1)
			queued[player] = nil
			if player.Parent == Players and not assignments[player] then
				-- No yields between claiming the plot and recording its owner.
				resetPlot(plot, player.UserId)
				assignments[player] = plot
				player:SetAttribute("PlotName", plot.Name)
				player:SetAttribute("PlotStatus", "Assigned")
				break
			end
		end
	end
end

local function enqueue(player)
	if assignments[player] or queued[player] or player.Parent ~= Players then
		return
	end
	player:SetAttribute("PlotName", nil)
	player:SetAttribute("PlotStatus", "WaitingForPlot")
	queued[player] = true
	table.insert(waiting, player)
	assignWaiting()
end

function PlotService.GetPlot(player)
	return assignments[player]
end

function PlotService.IsOwner(player, plot)
	return plot ~= nil and assignments[player] == plot and plot:GetAttribute("OwnerUserId") == player.UserId
end

function PlotService.Start()
	if started then
		return
	end
	started = true
	local folder = Workspace:FindFirstChild("Plots")
	if not folder or not folder:IsA("Folder") then
		warn("[PlotService] Create Workspace.Plots (Folder) and plot Models; players will wait until plots are configured and the server is restarted.")
	else
		local candidates = folder:GetChildren()
		table.sort(candidates, function(a, b)
			return a.Name < b.Name
		end)
		local names = {}
		for _, plot in ipairs(candidates) do
			if names[plot.Name] then
				warn("[PlotService] Duplicate plot name skipped: " .. plot.Name)
			elseif preparePlot(plot) then
				names[plot.Name] = true
				table.insert(plots, plot)
			end
		end
	end
	Players.PlayerAdded:Connect(enqueue)
	Players.PlayerRemoving:Connect(function(player)
		queued[player] = nil
		for index = #waiting, 1, -1 do
			if waiting[index] == player then
				table.remove(waiting, index)
			end
		end
		local plot = assignments[player]
		assignments[player] = nil
		if plot then
			resetPlot(plot, 0)
		end
		player:SetAttribute("PlotName", nil)
		player:SetAttribute("PlotStatus", nil)
		assignWaiting()
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		enqueue(player)
	end
end

return PlotService

]]></string>
        </Properties>
      </Item>
